                case UnknownEnum.Value_19:
                    return [["Hey! You're...Sally, right?", "Vannabelle"], ["...You know me?", "Sally"], ["I looked into Percy's Playhouse a bit in the past. It was a nice place!", "Vannabelle"], ["I didn't get AS into it as I did with Freddy's, but, uh...", "Vannabelle"], ["...Well, as a robot animal yourself, what do you make of, uh, all this? Must be weird, right?", "Vannabelle"], ["It's some bull, that's what!", "Sally"], ["The old guy said this tower's built from our pasts, right...?", "Sally"], ["But apparently not MINE! There's not a SINGLE schmuck here I recognize!", "Sally"], [" There's none of that loudmouth cat, no pesky minipoodles... Not ONE I actually know!", "Sally"], ["...Well, aside from the bear, but who here hasn't?", "Sally"], ["I mean... Based on the way you're talking about them...", "Vannabelle"], ["...Is there anyone you'd even actually WANT to see?", "Vannabelle"], ["...Hm. Fair point.", "Sally"], ["Maybe I should be grateful my brother and his gaggle of geese isn't here yukking it up.", "Sally"], ["Yeah!", "Vannabelle"], ["...Geese? Like, animatronic geese?", "Vannabelle"], ["Hm? No, like, someone who has poor judgement.", "Sally"], ["...Huh...", "Vannabelle"], ["...OH, is THAT where \"silly goose\" comes from?", "Vannabelle"], ["Probably? I dunno I'm not some freakin', etymologist or somethin'.", "Sally"], ["I dunno, I think you could be if you got a decent education.", "Vannabelle"], ["Implying I don't have one already?", "Sally"], ["Implying you fix up robots who get more attention than you ever did.", "Vannabelle"], ["...Alright, that one hurt a little.", "Sally"], ["C'mon, stick with me and I'll show you where my \"education\" comes in handy.", "Sally"]];
                
