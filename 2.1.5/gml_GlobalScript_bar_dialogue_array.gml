                case UnknownEnum.Value_2:
                    return [["Thanks, B- ...Wait a minute. Wait, hold on...", "Vanessa"], ["Billy. You wouldn't happen to be THE Billy, would you?", "Vanessa"], ["Worked a single week? Got the boss arrested?", "Vanessa"], ["Billy's inquisitive expression turned gleeful to be recognized in such a way.", ""], ["Huh, the rumors are true...", "Vanessa"], ["No one's ever quit so quickly before. Usually they either die or just keep working.", "Vanessa"], ["There's something about this company that makes people stick around for months or years...", "Vanessa"], ["You're quite the unique case, Billy boy.", "Vanessa"], ["Excuse me? Billy cringed.", ""], ["Yeah, sorry, the nickname popped in my head and I just...", "Vanessa"], ["Whatever, let's go...Billy-Bob.", "Vanessa"], ["Now that's a nickname Billy can get behind!", ""]];
                
                case UnknownEnum.Value_6:
                    return [["Y'know, you remind me a lot of myself when I was younger.", "Clark"], ["...How old are you, anyways?", "Clark"], ["Billy looked to the side while sipping on his delicious drink.", ""], ["...It's a mystery!", ""]];
                
                case UnknownEnum.Value_8:
