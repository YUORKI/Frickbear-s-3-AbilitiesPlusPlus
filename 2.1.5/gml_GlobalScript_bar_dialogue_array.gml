                case UnknownEnum.Value_4:
                    return [["Michael, the kind old crocodile man told me there's a way out of here! You and daddy can come back home with me!", "Elizabeth"], ["...Well, as much as I want to help YOU escape, Elizabeth...", "Michael"], ["...I cannot stand by helping...HIM.", "Michael"], ["Oh, Michael...why do you hate daddy so much? You know deep down he really does love us!", "Elizabeth"], ["Why, he even said you reek the slightest bit less ever since you got here! Would he really say that if he didn't love you?", "Elizabeth"], ["Elizabeth, he just wants to keep you under his thumb with shallow praise! He's...only using you!", "Michael"], ["Oh Michael, it's bad to let envy consume your heart!", "Elizabeth"], ["Just because I'm his favorite doesn't mean you can be so mean...", "Elizabeth"], ["Favorite?! If you saw what he said about you after your little incident with Baby, you'd be singing a different tune!", "Michael"], ["Is this because he doesn't buy you treats or let you stay past your bedtime like he does for me?", "Elizabeth"], ["...Sigh.", "Michael"], ["No matter how much you try to test me, I still want to make sure you get out of this place safely.", "Michael"], ["Besides...perhaps seeing all the monsters our father has created will be enough to change your mind.", "Michael"]];
                
                case UnknownEnum.Value_10:
                    return [["Uncle Henry!", "Elizabeth"], ["E-Elizabeth? You're here?! But, you...It was so long ago...", "Henry"], ["Oh, nevermind. It's good to see you again.", "Henry"], ["Your father isn't going to chew you out for speaking to me, is he?", "Henry"], ["Oh, don't worry! I know my father has said plenty of mean things about you, but I still think you're wonderful!", "Elizabeth"], ["Oh! Well, thank you!", "Henry"], ["Indeed! In fact, I think it's LOVELY that you have no sense of style and haven't shaved in months!", "Elizabeth"], ["And even if my father thinks it's disgusting, I think it's lovely your beard is full of worms!", "Elizabeth"], ["...Are those all things your father has said about me?", "Henry"], ["Yes! But it's okay. Everybody is different!", "Elizabeth"], ["Your beard would make for an excellent bird's nest, so keeping worms in there is a good idea!", "Elizabeth"], ["(Much to my chagrin....she really is her father's daughter.)", "Henry"]];
                
                case UnknownEnum.Value_11:
                    return [["...AH! ...Er...ELIZABETH! You're HERE!", "William"], ["...Wait, what are you doing here? I thought you were still...", "William"], ["Oh, Circus Baby?", "Elizabeth"], ["Well, she sort of had a mind of her own...and she was so mean that she booted me out.", "Elizabeth"], ["...Ah, I suppose that makes sense. She did have a rather big personality...", "William"], ["...But, bah, that's besides the point! You're HERE! You MUST come along with me, we haven't a moment to waste!", "William"], ["But Father...I thought you wanted me to stay away from your creations! After all, last time I-", "Elizabeth"], ["Last time you would've been fine had you followed my orders. I'm simply asking you to follow my orders again!", "William"], ["But I...", "Elizabeth"], ["Are you talking back to me!? Do you KNOW what happens to children who MISBEHAVE!?", "William"], ["Y-Yes, father... I-I'll follow you.", "Elizabeth"], ["Haha, excellent! See, this is precisely why you were always my favorite.", "William"], ["Now come along! You and I have someone to meet!", "William"], ["(...And that someone couldn't turn down a loving father, now could they?)", "William"]];
                
                case UnknownEnum.Value_17:
                    return [["...", "Mary"], ["...Ahem.", "Elizabeth"], ["...", "Mary"], ["...AHEM!", "Elizabeth"], ["...Oh. Oh! Me?", "Mary"], ["Sorry, I thought you just had glitter in your lungs.", "Mary"], ["Well I never! Here I was hoping to make some friends, but you don't even have the decency to wear a dress!", "Elizabeth"], ["...Yeah. Because I don't own one?", "Mary"], ["No one owns just one! You've got one for every day, surely!", "Elizabeth"], ["I don't even have one for Sunday, and that's like the most professional day!", "Mary"], ["How silly! Surely your daddy would buy you one if you simply asked!", "Elizabeth"], ["...My dad's dead, and my brother's broke.", "Mary"], ["So are mine, but that hasn't stopped them!", "Elizabeth"], ["From the sounds of things, it would seem they just don't love you enough...", "Elizabeth"], ["...Alright, I'm telling.", "Mary"], ["NO, NO, NO, WAIT!", "Elizabeth"]];
                
                case UnknownEnum.Value_15:
                    return [["H-Hey! Thanks for the drink!", "Cassie"], ["Say, I, um...Y-You... (Shoot, what's a good conversation starter?)", "Cassie"], ["...There's a lot of animatronics here, huh? Which one is, um, your favorite?", "Cassie"], ["Oh, that's quite easy! Circus Baby is absolutely wonderful!", "Elizabeth"], ["...Really...? One of the human looking ones...?", "Cassie"], ["N-Not that she isn't cool in her own way!  Just... Well, I see humans everyday, y'know!", "Cassie"], ["Well, which is YOUR favorite?", "Elizabeth"], ["Oh, well...I really like Roxanne Wolf! She's the coolest, and she's a really fast racer!", "Cassie"], ["She made my birthday really special...And, gosh, she even saved my life once!", "Cassie"], ["Oh! Well, that sounds wonderful! Can she serve ice cream as well?", "Elizabeth"], ["Well, uh... She brought a carrot cake out for me! ...One that was baked by the staff, but still...", "Cassie"], ["Well, she must be able to inflate balloons at the very least, correct?", "Elizabeth"], ["She, uh... There are balloons with her face on it all around the Pizzaplex!", "Cassie"], ["Hmph. I'm afraid your Roxanne Wolf may not measure up to my Circus Baby after all...", "Elizabeth"], ["Oh, come on! She's cool where it matters most, alright?", "Cassie"], ["Surely your Circus Baby has SOME flaw, right?", "Cassie"], ["Well...I suppose she IS the reason I'm here...", "Elizabeth"], ["Wait, she...she is?", "Cassie"], ["Oh my gosh. Oh my gosh, I'm so sorry.", "Cassie"], ["Oh, it's no trouble, really! Though I'm still not quite sure why my father included that claw as one of her features...", "Elizabeth"], ["...Well, I...guess we can consider this a tie?", "Cassie"]];
                
