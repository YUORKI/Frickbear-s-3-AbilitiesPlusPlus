                    return array_concat(Start, [["...", "Cassie"], ["...Say, uh...you've been working at this place for a while now, huh?", "Cassie"], ["Well, not exactly working...but I do have quite the storied past with it, yes.", "Michael"], ["Do you ever...uh...", "Cassie"], ["...Do you ever have nightmares? Like...about the animatronics?", "Cassie"], ["...Come again?", "Michael"], ["Ah, probably a stupid question, sorry.", "Cassie"], ["Oh, no no, it's fine, really!", "Michael"], ["Do...YOU have nightmares about them?", "Michael"], ["...Oh! No no, not me. It's just...", "Cassie"], ["...It's my dad. Uh, he's been around this place for a long time too.", "Cassie"], ["He told me about this...reocurring dream he had. Y'know, before I wound up here.", "Cassie"], ["...What was it about?", "Michael"], ["I don't remember how it went EXACTLY, but...", "Cassie"], ["...He says he's in his room, and he...hears footsteps. Bonnie's footsteps.", "Cassie"], ["He runs over to the door to lock it, but the lock's jammed, and he isn't able to close it. And when he looks behind him...", "Cassie"], ["...Bonnie's already there. But he...doesn't look right.", "Cassie"], ["He says he had these...weird eyes. And he was so tall he has to hunch over just to fit in the room. And he just...", "Cassie"], ["...Stands there, looming over him with these big, sharp teeth.", "Cassie"], ["Then he picks him up, brings him closer to his mouth, and...", "Cassie"], ["...Well, that's it. That's when he wakes up.", "Cassie"], ["...", "Michael"], ["...Oh, sorry. I know, dreams are kinda boring when someone's just describing them to you, huh?", "Cassie"], ["Oh, no no, it's no problem really! Er...quite an interesting story.", "Michael"], ["...Listen, would you like to, er...come with me and tell me more about it on the way?", "Michael"], ["Huh? Oh yeah, sure!", "Cassie"]]);
                
