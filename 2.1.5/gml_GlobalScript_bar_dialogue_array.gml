function bar_dialogue_array(arg0, arg1, arg2 = false)
{
    switch (arg0)
    {
        case UnknownEnum.Value_0:
            switch (arg1)
            {
                case UnknownEnum.Value_1:
                    return [["Hey there, Mike-a-million! Care for a drink?", "Jeremy"], ["Geez, you look roughed up. ...You sure you don't need a drink too?", "Mike"], ["Oh, no thanks! I never really liked the taste of beer, heheh...", "Jeremy"], ["Plus, I'd hate to be inebriated when there's so much work to be done!", "Jeremy"], ["Mm. You're a stronger man than I, my friend.", "Mike"], ["...Y'know, I've always wondered.", "Mike"], ["Yeah?", "Jeremy"], ["...How do you do it, exactly? Y'know, you've constantly been beaten down by this place, you've constantly been beaten down by LIFE, but...", "Mike"], ["Somehow, through it all, you still manage to keep that...big, stupid smile on your face.", "Mike"], ["O-Oh! Er...is that...a bad thing...?", "Jeremy"], ["Pff, far from it. I wish I could find something to smile about in this damned place.", "Mike"], ["Oh, well, um...", "Jeremy"], ["...Hey, why don't you come along with me? Happiness IS contagious, after all!", "Jeremy"], ["...Heh. Alright, let's see.", "Mike"]];
                
                case UnknownEnum.Value_2:
                    return [["Hey, Jeremy! What happened this time?", "Vanessa"], ["Oh, I wanted to try my luck with the King's Prize item the blue bot was selling! You'll never believe what happened...", "Jeremy"], ["I think I could wager a guess. Funtime Chica?", "Vanessa"], ["Yeah! How'd you know?", "Jeremy"], ["...Just a lucky guess. You gotta be careful about taking chances like that. You know what they say...", "Vanessa"], ["Go for broke?", "Jeremy"], ["No no, the house always wins. Don't get cocky, and all that.", "Vanessa"], ["You're on their turf and you gotta respect them. Give them the time of day, but keep them in line.", "Vanessa"], ["You know what I mean?", "Vanessa"], ["Gosh, I never thought about it like that... You really know your stuff, Vanessa!", "Jeremy"], ["I need to step up my game...Can you come with and show me the ropes?", "Jeremy"], ["Like training?", "Vanessa"], ["Yeah! I'd love to see the robot taming master in action!", "Jeremy"], ["Oh, what the heck, sure. Make sure you're watching real close, there's a lot of minutia to this stuff!", "Vanessa"]];
                
                case UnknownEnum.Value_3:
                    return [["Hiya, Fritz!", "Jeremy"], ["JEREMY! PERFECT timing.", "Fritz"], ["I've been ruminating on the nature of the Pizzeria Purgatory that is Faztartarus, and I've been needing someone to take notes!", "Fritz"], ["Oh! Well, gimme just a sec, I'm sure I've got a pen around here somewhere-", "Jeremy"], ["It's in your right breastpocket! I stuck it in while you were goggling the bartender's jugs!", "Fritz"], ["Her-...WHAT?", "Jeremy"], ["Her absurd amount of alcohol, my boy!", "Fritz"], ["OH! I dunno if I'd call it GOGGLING, but they've sure got one heckuva selection!", "Jeremy"], ["Right you are, Jeremy!", "Fritz"], ["Now, there's no better scout for uncovering the depths of hell than the living proof of Murphy's Law!", "Fritz"], ["So lead the way whilst I protect myself with this bar stool!", "Fritz"]];
                
                case UnknownEnum.Value_6:
                    return [["Hey, you're Clark, aren't you? Clark Fixy!", "Jeremy"], ["Oh, you...You know me?", "Clark"], ["Yeah! I recognize you from the hat on your little signature!", "Jeremy"], ["Your papers were very helpful, Mr Fixy!", "Jeremy"], ["Those're still up? Wow, heh. Well, I'm glad I could help.", "Clark"], ["Yeah! And that file you put together was a very very interesting expose! I learned a lot from that...", "Jeremy"], ["...Wait, those...You found those? HOW!?", "Clark"], ["Woah, I just bought them from the Upgrade Cadet, that's all! Was that, um, was that bad?", "Jeremy"], ["(So they found their way to the public after all... Candy Cadet, you magnificent piece of engineering...)", "Clark"], ["No, no...Not at all. Thanks for telling me this, kid. Means a lot to me.", "Clark"], ["Say, need a hand out there? Let a veteran lift some weight off your shoulders.", "Clark"], ["I'd love to get to know you better, Mr. Fixy! It's a deal!", "Jeremy"]];
                
                case UnknownEnum.Value_8:
                    return [["Wahaha! If it isn't my ever-reliable employee! I was hoping at least one of you chumps made it down here!", "The Boss"], ["...Listen, eh...about your paycheck. See, I was GONNA pay you, but then I wound up here!", "The Boss"], ["A-And the jerk that runs the place won't let me into my bank account!", "The Boss"], ["And see, that's funny, because I was gonna give you...uh...a BIG RAISE! Yeah, that's right! Lotsa gold coinses! But these chumps just won't let me!", "The Boss"], ["So, listen, I'll cut you a deal. Help me out of here, and you'll get your paycheck and THEN some!", "The Boss"], ["Might even consider a promotion! Yeah, you'd like that, wouldn't you? Let's-a go!", "The Boss"]];
                
                case UnknownEnum.Value_11:
                    return [["Hey Mister! You look awfully lonely...", "Jeremy"], ["I assure you it's by choice. I never much cared for the company of others. They're nothing but noise.", "William"], ["Aw, don't say that! Nothing beats spending time with a good friend, if you ask me.", "Jeremy"], ["Maybe you and I could be friends?", "Jeremy"], ["...", "William"], ["...Boy, you sure look mad. I think I'm gonna go ahead and get out of here...", "Jeremy"], ["...Feel free to join me!", "Jeremy"], ["(He'd make a decent meat shield, if nothing else...)", "William"]];
                
                case UnknownEnum.Value_13:
                    return [["Oh my! Are you alright? Did one of the animatronics do that to you, dear?", "Fiona"], ["Oh, no no no! Don't worry, I was like this when I got here!", "Jeremy"], ["You were? Well, gosh, that might be even worse...", "Fiona"], ["Eerrr, I mean, uh...I'm fine! I'm in perfectly good health!", "Jeremy"], ["But...We're both dead, are we not?", "Fiona"], ["Uh, well...Um...", "Jeremy"], ["...It doesn't hurt! My face is just healing!", "Jeremy"], ["Oh, thank goodness, that's a relief...", "Fiona"], ["Let's go, we might be able to find Dollie around to treat you!", "Fiona"], ["Alright! (...Who's Dollie?)", "Jeremy"]];
                
                case UnknownEnum.Value_16:
                    return [["Howdy, sir!", "Jeremy"], ["GAH!!!", "Hudson"], ["Wh-Why do you look like that?!", "Hudson"], ["Um...Well, it's kind of a long story... I got cut, crashed, and burned...", "Jeremy"], ["But my parents helped pay for my medical bills, so I'm all fine now!", "Jeremy"], ["...", "Hudson"], ["...", "Jeremy"], ["...Sir? Are you alright? Sir?", "Jeremy"], ["Hm? I'm sorry, say that again.", "Hudson"], ["Oh, I just said that I have these bandages because my face needs to recover!", "Jeremy"], ["Ah, right, I g-guess that makes sense. Sorry that you have to look like that.", "Hudson"], ["Oh, it's no problem! Time heals all wounds, after all!", "Jeremy"], ["We should get back to work though. Wanna come with?", "Jeremy"], ["Uuuuh...Alright, sure.", "Hudson"]];
                
                case UnknownEnum.Value_17:
                    return [["Oh my god, did your face melt off?", "Mary"], ["N-No! Well...not all of it!", "Jeremy"], ["Do you see your face in the mirror?", "Mary"], ["Like when you look in your reflection you see your face but it's evil?", "Mary"], ["Or when you look in the mirror do you see someone ELSE'S face?", "Mary"], ["No! Of course not! These bandages are just there until it heals, that's all!", "Jeremy"], ["Aw man. Bummer.", "Mary"], ["Well, lemme know whenever you get physically scarred somewhere else.", "Mary"], ["Actually, it kinda happens on the regular...", "Jeremy"], ["...Ok, I'm sticking with you.", "Mary"]];
                
                case UnknownEnum.Value_18:
                    return [["Woah! What's an animatronic doing here?", "Jeremy"], ["Bandages...ugly? SCARRED! Oh goodness, what HAPPENED to you?", "Strings"], ["Oh- Well...A little bit of everything, I suppose!", "Jeremy"], ["If I had to get specific I'd say it was mostly the burns and cuts that caused it.", "Jeremy"], ["But as long as we're asking questions, what's your...function?", "Jeremy"], ["Is that rude to ask?", "Jeremy"], ["It's- Innocent! Naive? FINE! It's fine. I'm Strings, an Artificial Intelligence designed for security.", "Strings"], ["No kidding! I bet you've got, like, lasers and saw blades and stuff!", "Jeremy"], ["No.", "Strings"], ["Oh! Uh... Can you maybe fly around and tase the bad guys?", "Jeremy"], ["Nope.", "Strings"], ["...Well I don't mean to sound rude, but what CAN you do?", "Jeremy"], ["Doubt? ASSURANCE! I'm REALLY good at watching things!", "Strings"], ["...", "Jeremy"], ["Me too!", "Jeremy"]];
                
                case UnknownEnum.Value_19:
                    return [["Pardon me, miss robot! Er...Is it rude to call you that?", "Jeremy"], ["Egh, yeah, no, don't. If you have to call me something, call me a poodle. Better yet, why don't you use my actual name?", "Sally"], ["You're a poodle? Say...You wouldn't happen to know one named Percy?", "Jeremy"], ["Wh-?! What're you bringing up my brother for?", "Sally"], ["Um... Percy's Playhouse, right? I sent an application there while I was in the hospital!", "Jeremy"], ["It DID get rejected, though. They said I needed more time to recover before they could consider hiring me...", "Jeremy"], ["...So it's a good thing Fazbear took me on!", "Jeremy"], ["...Right, yeah, very good.", "Sally"], ["Percy's a real piece. A piece of GARBAGE! That jerk tore me apart for scrap, and now I'm stuck here!", "Sally"], ["So thanks a loooot for bringing him up, wiseguy.", "Sally"], ["O-Oh, I'm...I'm really sorry! I didn't know, I'm uninformed! I didn't mean to offend, miss poodle!!", "Jeremy"], ["I'm- Ugh...", "Sally"], ["...How about I come with you and tell you about all the other bullhonky they do at Percy's Playhouse?", "Sally"], ["It might do you some good to stop being so ignorant.", "Sally"]];
                
                default:
                    return bar_dialogue_array(-1, arg1);
            }
        
        case UnknownEnum.Value_1:
            switch (arg1)
            {
                case UnknownEnum.Value_0:
                    return [["S'up. How's your \"shift\" going?", "Mike"], ["It's going pretty alright, thanks for asking! Just a bit worried about being stuck here too long...", "Jeremy"], ["I'm supposed to see a movie with my dad tomorrow, I'd hate to be too exhausted to go!", "Jeremy"], ["Do you...have a good relationship with your parents, Jeremy?", "Mike"], ["Yeah! It's thanks to them I've gotten to where I am today!", "Jeremy"], ["...", "Mike"], ["That's nice.", "Mike"], ["(...Wait, um...)", "Jeremy"], ["H-Hey! You said you had a sister, right?", "Jeremy"], ["Uh- Yeah, Mary.", "Mike"], ["...Dooooes she have a little lamb?", "Jeremy"], ["What? ...Oh. Heh, heheh.", "Mike"], ["She does have this little black sheep doll she keeps in her room.", "Mike"], ["Aw, that's so cute!", "Jeremy"], ["Speaking of which, there was actually this one time...", "Mike"], ["Uh, actually, this seat is way too stiff. I'll tell you about it at work.", "Mike"], ["Sounds good to me! (Phew, saved it!)", "Jeremy"]];
                
                case UnknownEnum.Value_2:
                    return [["Ah, thanks, Mike!", "Vanessa"], ["How are you holding up out there? I can only imagine how disorienting this must be for you.", "Vanessa"], ["Ugh...don't even get me started. I have no idea how you managed to put up with place for so long.", "Mike"], ["...How DID you manage to put up with this place for so long? I was only there a week and I already hated it.", "Mike"], ["Haha, well...this job has some perks, y'know?", "Vanessa"], ["...Like what?", "Mike"], ["Oh, well, uh...Freddy's band is pretty cute, right?", "Vanessa"], ["...\"Cute\" is just about the last word I would use to describe them.", "Mike"], ["Oh, it'd be a different story if you got to see them during the day! Their shows really are charming, if you only got to see one...", "Vanessa"], ["...I can tell you where the showtime button is if you wanna give it a try once we're out of here.", "Vanessa"], ["...If singing their stupid song can distract them from wanting to kill me, then sure.", "Mike"]];
                
                case UnknownEnum.Value_3:
                    return [["...Ah, MIKE! MICKEY! MIKIMILLIEN! You're EXACTLY the man I wanted to see!", "Fritz"], ["I-I am? You...know my name?", "Mike"], ["Indeed, indeed! Oh, I'd HATE to see how Foxy looked after he tried running into YOUR office!", "Fritz"], ["I...what?", "Mike"], ["Just look at you! With your build, I'm sure you could've knocked Freddy's head clean off his shoulders in a single swing!", "Fritz"], ["So tell me, how bloody was it? How many did you do in before you were delivered the fatal blow!? Paint me a picture!", "Fritz"], ["I...", "Mike"], ["...Hadn't considered that as an option?", "Mike"], ["Ah, so you must've been too won over by their craftsmanship to dare tarnish it, eh? I understand that feeling all too well, my friend!", "Fritz"], ["I myself prefer watching them fight each other anyway. Some of their moves really can be gruesome.", "Fritz"], ["...Do you wanna get out of here?", "Mike"], ["Oh, yessir!", "Fritz"], ["...Can you carry me?", "Fritz"]];
                
                case UnknownEnum.Value_4:
                    return [[arg2 ? "...Oh! Hey, other Mike." : "Hey, other Mike.", "Mike"], ["Uh...no hard feelings about not seeing your whole creepy-mask-plan through to the end, right?", "Mike"], ["Ah, no, not at all. Now that we've found ourselves here, it's hardly my first concern.", "Michael"], ["Besides, assuming we do make it out of here...there's always next year.", "Michael"], ["Right. Of course.", "Mike"], ["...", "Mike"], ["...Wait, what do you mean \"next year\"?", "Mike"], ["...Hm? What of it?", "Michael"], ["Well, y'know, when you first bugged me in that parking lot, you made it sound like this was...I dunno, something you only had one shot at.", "Mike"], ["Something about how this was your only chance for a long, long time, right?", "Mike"], ["Well...yes. His birthday only comes around once a year.", "Michael"], ["Once a - A YEAR!?", "Mike"], ["You had me risking my job for THAT!? What the hell!?", "Mike"], ["A certain degree of urgency was warranted, given the importance of the task. I thought you'd understand.", "Michael"], ["I have bills to pay, man! I don't have time for your...weirdo ghost quests!", "Mike"], ["Well, you'd best make time, because neither of us are making it out of here otherwise.", "Michael"], ["...Will you follow along with me just this one last time?", "Michael"], ["...You're lucky I've got someone to get back to.", "Mike"]];
                
                case UnknownEnum.Value_6:
                    return [["Uh, you're...One of the engineers or something, right?", "Mike"], ["Oh, eh...More or less. Why do you ask?", "Clark"], ["Do you know... WHY the animatronics are... like that?", "Mike"], ["God, I wish I knew. They're WEIRD, right?", "Clark"], ["How the hell are the animatronics capable of climbing into the vents?", "Clark"], ["Why are they making the vents tough enough to support the weight of an entire animatronic?", "Clark"], ["Honestly, I'm more confused about the whole...powered doors thing.", "Mike"], ["Right. So, when the bots are made out of such unnecessarily high-grade metal, heavy duty doors are the only thing that can stop them.", "Clark"], ["...Wouldn't it just be easier to...I don't know, make the animatronics NOT want to kill people?", "Mike"], ["THAT'S WHAT I'M SAYING!! Finally, someone else says it!", "Clark"], ["It's probably old Afton's fault somehow. He doesn't concede on ANYTHING. He seems to have a thing for making people miserable.", "Clark"], ["Well, at least you didn't have to work double shifts for the sleaziest guy this side of Hurricane.", "Mike"], ["Oh, please! There's no way whoever you're dealing with is sleazier than Burrows!", "Clark"], ["That man would kick puppies if he got a dime for it! If he didn't make a robot to do it for him first!", "Clark"], ["...Huh. I guess what they say is true. Misery loves company.", "Clark"], ["I guess so.", "Mike"], ["...Who knows, maybe this pity party'll be the one to find the way out.", "Mike"]];
                
                case UnknownEnum.Value_11:
                    return [["Well, well! A hench young fellow such as yourself could be of great use to me!", "William"], ["Sorry, you're not my type.", "Mike"], ["What? No. I simply mean to say that if we put that rugged body of yours to work, both of us could benefit quite handsomely.", "William"], ["I JUST said you're not my type.", "Mike"], ["...What I'm trying to say is that with my cunning and your muscle, I should have little trouble escaping this wretched place.", "William"], ["Ever tried talking about someone besides yourself, old timer?", "Mike"], ["...We. WE could escape.", "William"], ["That's better.", "Mike"], ["Alright, sure.", "Mike"]];
                
                case UnknownEnum.Value_17:
                    return [["Aw, sweet! Thanks-", "Mary"], ["...There's no alcohol in this, is there?", "Mary"], ["Nope.", "Mike"], ["God- Mike, you'd think you'd gain a little frickin' appreciation for living things up when you're ACTUALLY dead!", "Mary"], ["Yeah, and I have. Which is why I'm not letting you run around here getting into who-knows-what until you...", "Mike"], ["Die AGAIN?", "Mary"], ["...Listen, I'm not gonna pretend I know how this all works. But I sure as hell don't wanna lose you and find out.", "Mike"], ["We're gonna stick together, work together, and get out of here. Together.", "Mike"], ["...Alright?", "Mike"], ["...Yeah. Yeah, this bar was lame anyways. Lead the way, Mikey.", "Mary"]];
                
                case UnknownEnum.Value_18:
                    return [["Oh no no no no NO! What has happened to YOU?!", "Strings"], ["Uh, same thing as everyone else? We all died.", "Mike"], ["No no, not that!", "Strings"], ["Your shade, your PIGMENT!! It's completely off color! Why aren't you GREEN!?", "Strings"], ["I'm sorry?", "Mike"], ["Your hair, Grike! You've lost all your Greenish Glow!", "Strings"], ["Has this place worn you so thin?! Will MY paint fade as well?!", "Strings"], ["And how will our loss of pigment affect how others perceive us?!", "Strings"], ["No...NO!!! I can't be seen without my red sheen!!", "Strings"], ["We have to get you out of here, so you can go back to being your vibrant self!!", "Strings"], ["...Y'know what, whatever, sure.", "Mike"]];
                
                case UnknownEnum.Value_14:
                    return [["You're...the other Mike's little sister, right?", "Mike"], ["Oh! You know my brother?", "Elizabeth"], ["Yeah, we met a couple times before I wound up...well, here.", "Mike"], ["...You know, my little sister's here too, funnily enough. Seen a moody girl with twintails running around here?", "Mike"], ["Oh, Mary! Yes, I do believe I've run into her.", "Elizabeth"], ["So she's your sister, correct? Do you take care of her well?", "Elizabeth"], ["Well, I mean...I put food on the table. It's tough, but I do what I can.", "Mike"], ["That's all? Gosh, how embarrassing! I'd be embarrassed to have YOU as a brother.", "Elizabeth"], ["What? I- Jeez,who taught YOU to be so rude!?", "Mike"], ["Oh, my father told me if I'm rude to strangers I can weed out the ones who aren't worth listening to.", "Elizabeth"], ["But you're still here, so I must be able to trust you! Yay! Let's go!", "Elizabeth"], ["(Geez, and I thought Mary was a handful...)", "Mike"]];
                
                case UnknownEnum.Value_16:
                    return [[arg2 ? "Geez! You're...you're BIG!" : "AAAAGH! GEEZ, YOU'RE BIG!", "Hudson"], ["Uh... Okay.", "Mike"], ["NO no wait I'm- I'm sorry for freaking out.", "Hudson"], ["It's just, you're like, the size of some of these robots, and...", "Hudson"], ["Like...You're...HUGE!", "Hudson"], ["Yeah, man. I know I'm on the bigger side. You don't have to keep--", "Mike"], ["No no no, like, you actually look strong!! You look capable!!", "Hudson"], ["Please, PLEASE let me come with you. PLEASE.", "Hudson"], ["I'm so TIRED of being STUCK HERE!!! WITH THESE...THESE MONSTERS!!", "Hudson"], ["You GOTTA GET ME OUTTA HERE!!", "Hudson"], ["...Uh...", "Mike"], ["Just, take it down a notch and sure.", "Mike"], ["THANK YOU!!!", "Hudson"]];
                
                case UnknownEnum.Value_15:
                    return [["...Hey, you're that kid from Mary's class, right?", "Mike"], ["Oh, yeah! Mr. Berg, Room 125!", "Cassie"], ["A-Are you her dad?", "Cassie"], ["AUUUGH, I. AM. Not. I am not.", "Mike"], ["...You okay?", "Cassie"], ["It's fine. Just...reminded that I'm gettin' on in years, that's all.", "Mike"], ["...You, uh...", "Mike"], ["You get along with Mary alright?", "Mike"], ["O-Oh! Well. Um. Y-Yeah, kinda.", "Cassie"], ["...She do anything wrong?", "Mike"], ["N-No! Not...particularly.", "Cassie"], ["I-I just never really got to KNOW her before we got down here.", "Cassie"], ["I don't think we even spoke during orientation.", "Cassie"], ["Aw, jeez...", "Mike"], ["B-But we've been talking a lot more now, a-and I think we're getting along really well!", "Cassie"], ["...I-I hope so, at least.", "Cassie"], ["...Huh.", "Mike"], ["Well, leave it to Mary to find company in the pits of hell, huh?", "Mike"], ["Heheh, yeah!", "Cassie"], ["...You think we'll find her around here?", "Cassie"], ["Only one way to find out.", "Mike"]];
                
                case UnknownEnum.Value_8:
                    return bar_dialogue_array(UnknownEnum.Value_0, arg1);
                
                default:
                    return bar_dialogue_array(-1, arg1);
            }
        
        case UnknownEnum.Value_2:
            switch (arg1)
            {
                case UnknownEnum.Value_0:
                    return [["'Nessa! It's good to see you!! Are you holding up alright?", "Jeremy"], ["Yeah! I've got enough experience under my belt to get through.", "Vanessa"], ["But, well, you're a newbie...And I hate to see you suffering through this place on your own.", "Vanessa"], ["Oh, I'm not suffering! I'm just having a bit of a tough time here in Faztartarus, that's all!", "Jeremy"], ["Don't call it that.", "Vanessa"], ["But... How many times have you ended up here?", "Vanessa"], ["Well, let's see...There was the time I couldn't find the button to reset the music box on my first night, then the time I tried talking to Chica...", "Jeremy"], ["...There was that time I tripped and fell onto that pointy robot with the big claw while salvaging...", "Jeremy"], ["There was that time my laser doors ran out five seconds before 6 A.M...", "Jeremy"], ["Well, then if we include the stuff that's happened HERE then-", "Jeremy"], ["Jeremy...", "Vanessa"], ["C'mon, I'll get you outta here. You don't deserve to be stuck in a place like this.", "Vanessa"], ["You really don't need to, Vanessa! I can handle myself!", "Jeremy"], ["But...I'll happily come along to spend time with a friend!", "Jeremy"]];
                
                case UnknownEnum.Value_1:
                    return [["Hey! ...Mike?", "Vanessa"], ["...Snrrrzzzzzzz....", "Mike"], ["MIKE!! WAKE UP!!!", "Vanessa"], ["GAH.", "Mike"], ["What's the big...Oh, hey.", "Mike"], ["Hey! I bought you a drink. I uh, did not realize you were sleeping.", "Vanessa"], ["...The counter can't be THAT comfortable, Mike.", "Vanessa"], ["Yeah, no, not at all, but I'm bum outta luck for other places to do it.", "Mike"], ["This place's safe enough. I'll make do.", "Mike"], ["...Miiiike!!!", "Vanessa"], ["You can't SERIOUSLY be more focused on finding a good place to sleep than escaping!", "Vanessa"], ["Why does it matter? There's not a time limit on this, right?", "Mike"], ["Why even bother if you're not gonna give it your all?!", "Vanessa"], ["What's the point of even stepping out the door if you're not gonna put on your shoes first?!", "Vanessa"], ["C'mon Mike, you deserve better, but you're never gonna get it if you just keep-", "Vanessa"], ["Alright, alright! I'll get moving.", "Mike"], ["I doubt I'd be getting a nap with you around anyways...", "Mike"]];
                
                case UnknownEnum.Value_3:
                    return [["Oh, heavens to betsy! The company's PARAMOUNT patroller buying ME a drink?", "Fritz"], ["Somebody pinch me, THROTTLE me, I must be dreaming!", "Fritz"], ["...What?", "Vanessa"], ["Why, a freak like me is a better fit among the terrifying automaton troupe!", "Fritz"], ["Any sane nightguard would assume I'm a robot shaped after man and passed off for the real deal!", "Fritz"], ["C'mon, Fritz. Don't say that about yourself.", "Vanessa"], ["You're very good at this job. And, well...", "Vanessa"], ["...These shifts are a lot less dull with you around.", "Vanessa"], ["...Aaaaaand?", "Fritz"], ["...", "Vanessa"], ["...AND I'm glad SOMEONE else around here wants to understand why this company is so weird.", "Vanessa"], ["I don't have it in me to believe in my own theories and push them like you.", "Vanessa"], ["Oh, 'Nessa! I knew your denialism was just a dedication to the employee handbook!", "Fritz"], ["Well then, we've got no time to waste! Let's test your theories!", "Fritz"], ["...Wait, MY theories?", "Vanessa"], ["Please, let me hear your most implausible ideas, and let's see what we can dig up!", "Fritz"]];
                
                case UnknownEnum.Value_8:
                    return bar_dialogue_array(UnknownEnum.Value_0, arg1);
                
                case UnknownEnum.Value_5:
                    return [["...Oh. My. God.", "Vannabelle"], ["VAN-VAN!! YOU FINALLY CAME AROUND! C'MERE AND GIVE ME A BIG KISS, YOU!", "Vannabelle"], ["NO! No, oh, GOD, no. Especially not here.", "Vanessa"], ["...Listen, I hope you understand how desperate this situation is for me to come to you of all people.", "Vanessa"], ["Allies are tough to come by in a place like this, and...well...", "Vanessa"], ["...You're probably the only other person here crazy enough about these things to survive against them.", "Vanessa"], ["...Well, save for Fritz, but he's, um...busy.", "Vanessa"], ["You REEEAAALLY mean it?", "Vannabelle"], ["Oh, NESSA! You really DO care!!", "Vannabelle"], ["...Gah, everyone's looking now.", "Vanessa"], ["Come on, I'm getting you out of here before you embarrass me even more.", "Vanessa"]];
                
                case UnknownEnum.Value_6:
                    return [["Good to see an honest to god professional here.", "Clark"], ["Oh! Well, thank you for recognizing my efforts, hah.", "Vanessa"], ["You've...been with this company for a while, huh? I don't think they've hired a dedicated handyman in years now...", "Vanessa"], ["Oh yeah. Been around since the Fredbear days.", "Clark"], ["W-Woah! THAT long?", "Vanessa"], ["Eh, you do a good enough job and don't talk back to your bosses, you stick around a while.", "Clark"], ["...Probably helps that all the equipment's so damn old, too.", "Clark"], ["None of the newbies can even wrap their head around the stuff, and management's too cheap to train 'em.", "Clark"], ["Oof. Ain't that the truth...", "Vanessa"], ["...Well, you've gotta be good to have lasted this long, especially at THIS company.", "Vanessa"], ["Wanna come along and show me what you're made of?", "Vanessa"], ["Can't promise I'm the best, but I promise I'll do my best. Let's get a move on.", "Clark"]];
                
                case UnknownEnum.Value_10:
