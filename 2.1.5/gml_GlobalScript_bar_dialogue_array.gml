                    return array_concat(Start, [["(So THIS is William...The man who ruined Fazbear's...)", "Vanessa"], ["(An absolute monster...A scumbag whose name precedes him...)", "Vanessa"], ["(...And yet, I can't help but wonder just HOW awful he really is in person.)", "Vanessa"], ["Yeah, um... I'll see what I can do.", "Vanessa"]]);
                
