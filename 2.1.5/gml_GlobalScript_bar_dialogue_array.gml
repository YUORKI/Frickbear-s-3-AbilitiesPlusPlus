                case UnknownEnum.Value_4:
                    return [["Heeeey, cutie! I gotcha a drink! Y'know, to show how much I care and stuff~...", "Vannabelle"], ["...", "Michael"], ["...Haha, and, like, for the record, you're looking SO cute right now. Especially for someone who's, like, died. Twice.", "Vannabelle"], ["...", "Michael"], ["...", "Vannabelle"], ["...Okay, look, I didn't know he was your dad, alright?", "Vannabelle"], ["But you sure as hell knew he was a serial killer.", "Michael"], ["H-Hey, listen! I couldn't help it, honest! He, like...had a spell over me or something, I dunno!", "Vannabelle"], ["C'mon, you know if I was in the right headspace I wouldn't have done all that, right? I know I'm weird, but I'm not THAT weird!", "Vannabelle"], ["...", "Michael"], ["...I suppose I'm not proud of all I did for him, either.", "Michael"], ["If I help you out of here, IF...", "Michael"], ["...Will you, for once in your life, act responsibly?", "Michael"], ["Will you make the right choice with your second lease on life?", "Michael"], ["Yep! Mhm! Positively! And I mean that!", "Vannabelle"], ["...", "Michael"], ["...Okay, then. Let's get you out of here.", "Michael"]];
                
                case UnknownEnum.Value_6:
