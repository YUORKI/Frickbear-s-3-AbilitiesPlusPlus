                    return [["Th-Thank you, sir!", "Edwin"], ["If I may, your attire positively SCREAMS business! Is that real wool?", "Edwin"], ["It's real, yeah! Real CHEAP! The PRICE I got this thing at, it was a steal!", "The Boss"], ["So it's...not real wool?", "Edwin"], ["Nah. But it's got cotton!", "The Boss"], ["Erring on the side of business casual, but that has perks, like appearing more approachable to workers and customers!", "Edwin"], ["Sometimes, how you present yourself can really make or break your business...", "Edwin"], ["...By-the-by, how do you get your mustache to look like that?", "Edwin"], ["I ain't tellin' you squat! The brand of mustache wax I like costs chump change!", "The Boss"], ["If stinkers like you start buying it all up and raising the price, I'll have nothing! Find your own!", "The Boss"], ["I-I'm not trying to edge in on your cheap mustache wax, sir!", "Edwin"], ["I just thought, ah, I could try growing my own facial hair! Maybe a more aged or rugged look would help my sales, y'know?", "Edwin"], ["Your mustache IS very fashionable, so I just wanted to ask...", "Edwin"], ["Eh, you're right! nobody's got a stache as fine as me! Alright, I'll give you my exclusive stache combing tips!", "The Boss"], ["Just help me get out of this dump, I've got a REAL business to run!", "The Boss"], ["Of course, sir!", "Edwin"]];
                
