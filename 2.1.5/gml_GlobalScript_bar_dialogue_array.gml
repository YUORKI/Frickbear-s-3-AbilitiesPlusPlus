                case UnknownEnum.Value_7:
                    return [["...Woah, Belle! It's you! It's...YOU you, dude! Up top!", "Frank"], ["Heh, yeah! Yeah...it seems like whatever weird spell was over me went away once I wound up here...", "Vannabelle"], ["Yeah, man! Like, what was UP with that anyway?", "Frank"], ["Clark's always telling me video games rot your brain, but that's, like...what ACTUALLY happened to you, dude.", "Frank"], ["I feel, like...kinda bad for being jealous back then, man.", "Frank"], ["Aww, c'mon Frank, don't be! You couldn't have known!", "Vannabelle"], ["I mean...it's not like I knew I'd get digital brainworms from QA testing a video game either.", "Vannabelle"], ["Yeah man, like...something's UP with the software around here. Like, all of it.", "Frank"], ["Like...there was this one time I was playing Trash Stacker, and I think a ghost tried talking to me through the shapes of the blocks, man.", "Frank"], ["...Woah, what? Wait, really? What'd it say?", "Vannabelle"], ["I dunno. I hit a triple T-spin and I think that scared it away.", "Frank"], ["Ah. Figures.", "Vannabelle"], ["...Wanna teach me how to do that once we get out of here?", "Vannabelle"], ["If it helps keep the ghosts away, absolutely, man.", "Frank"]];
                
                case UnknownEnum.Value_10:
                    return [["Sorry if this is a sensitive subject, but...", "Vannabelle"], ["You and...y'know, HIM...worked together for a LONG time, right?", "Vannabelle"], ["...Did he ever ask YOU to build a mech body with a TV head for him?", "Vannabelle"], ["Several times, yes. Almost as soon as our first restaurant took off.", "Henry"], ["Oh my god. HOW long was he planning this?", "Vannabelle"]];
                
                case UnknownEnum.Value_11:
