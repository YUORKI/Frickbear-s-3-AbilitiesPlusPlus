                case UnknownEnum.Value_0:
                    return [["Oh, thank you! I-", "Jeremy"], ["Oh. Wow. You're um...small!", "Jeremy"], ["Teenagers tend to be, yes.", "Mary"], ["Oh, I'm sorry! I just didn't think they'd let children in here...", "Jeremy"], ["In hell or in a bar?", "Mary"], ["...Neither, I guess!", "Jeremy"], ["Well life is full of surprises. Just like the surprise scorpion I put under your seat.", "Mary"], ["The surprise WHAT?", "Jeremy"], ["HA! Just messing with you, man.", "Mary"], ["C'mon, let's get outta here. I think we're gonna have fun together.", "Mary"], ["Ah, geez...I guess it'd be the responsible thing to do.", "Jeremy"]];
                
                case UnknownEnum.Value_1:
                    return [["Mary?! What the hell are you doing here?", "Mike"], ["Hello, Mike. I'm doing great, thank you for asking.", "Mary"], ["Jeez, wasn't Jane supposed to be watching you while I was gone?", "Mike"], ["Yup, and she did one helluva job.", "Mary"], ["...So how'd your nightshift go?", "Mary"], ["Eugh. As far as I'm concerned I'm still on it.", "Mike"], ["None of this place makes any sense... You'd think it'd be a cushy job until you add in the killer cartoon animals.", "Mike"], ["...And now I guess I gotta deal with you, too.", "Mike"], ["Woah. Hey. \"Deal with\"? I've been doing perfectly fine on my own, I'll have you know.", "Mary"], ["...Right. Okay. Sure.", "Mike"], ["Tell you what. I'll keep going ahead, deal with the killer robots, haunted antics, and life-threatening challenges...", "Mike"], ["...And you stay here with the drunkards and Booby Bird over there.", "Mike"], ["Wha-! No fair!", "Mary"], ["Augh. Fine. You can tag along, but I'm gonna be really annoying if one of us dies.", "Mary"], ["Heh. Just try and get me a decent coffin..", "Mike"], ["No promises.", "Mary"]];
                
                case UnknownEnum.Value_2:
                    return [["Vanessaaaaaaaaa.", "Mary"], ["No.", "Vanessa"], ["C'mon! You've worked with Fazbears for like a BAZILLION years. Surely you've covered up SOME murders.", "Mary"], ["Listen, just because I have my history with the company doesn't mean I'm connected to EVERY single event that happened to it.", "Vanessa"], ["Okay, yeah. That's fair. Yeah.", "Mary"], ["...But you'd TOTALLY have the RECORDS to it, right?", "Mary"], ["Mary, I don't know what you think I do here as my JOB...", "Vanessa"], ["...But it's not mulling over a desk to try and twist some kid's broken finger into a sob-story for the public.", "Vanessa"], ["Right, because that's for the pencil pushers in the law firm to tackle.", "Mary"], ["Exactly.", "Vanessa"], ["...That's not to say I don't have my fair share of stories, but you've heard just about all of them.", "Vanessa"], ["Y'know. Gregory, those music man prototypes, and DAVE.", "Vanessa"], ["Who's Dave?", "Mary"], ["Oh my god. I haven't told you about Dave.", "Vanessa"], ["What happened to Dave? Did he die? Did someone die? Did he kill someone?", "Mary"], ["...Okay, let's walk and talk. It's a whole thing.", "Vanessa"]];
                
                case UnknownEnum.Value_4:
                    return [["Hey, can I ask you some dead people questions, or would that be...offensive?", "Mary"], ["Only if you call them \"dead people questions\".", "Michael"], ["Okay, I got some corpse curiosities for you.", "Mary"], ["...Have at it.", "Michael"], ["Why do you wear a hoodie instead of scaring people for fun?", "Mary"], ["If we're dead, why are you still a rotting corpse and not a normal dude?", "Mary"], ["Did you choose to be purple or was that your court-mandated zombie color?", "Mary"], ["Why do your eyes glow, are they haunted? Are you haunted?", "Mary"], ["And if you're still a zombie after this, can you help me get a spot on Spectral Scoopers?", "Mary"], ["Alright, let's see...", "Michael"], ["I wear my hoodie to prevent my pet locusts from escaping.", "Michael"], ["I'm still a corpse as I wish to sell my likeness as a metal album cover.", "Michael"], ["I'm purple for an amazing reason.", "Michael"], ["My eyes glow because they shoot lasers.", "Michael"], ["And I won't be a zombie after this, I'll be a ghoul. There's a big difference.", "Michael"], ["Wow!", "Mary"], ["...Okay, now how much of that was true?", "Mary"], ["Not a word of it.", "Michael"], ["You're a riot, Mike 2. You're coming with me.", "Mary"]];
                
                case UnknownEnum.Value_11:
                    return [["...Hm. Strange.", "William"], ["Normally I'M the one buying gifts to lure children to their gruesome demise, not the other way around...", "William"], ["Yeah, well...", "Mary"], ["I figured if anyone was going to know about death and stuff, it'd be you.", "Mary"], ["...On account of everyone either hating or blaming you for theirs.", "Mary"], ["Yes, well...people often detest what they could never hope to achieve.", "William"], ["...And by that logic, you're pressing your luck just talking to me!", "William"], ["Oh, what are you gonna do? Kill me twice?", "Mary"], ["Besides, now you owe me a favor, and I know you're not above backstabbing me. So, instead..", "Mary"], ["...I want you to find my body and prop it up so when it's found it scares the hell out of someone.", "Mary"], ["Wh- You can't just expect me to-", "William"], ["...Wait, that's not bad. That's not bad at all.", "William"], ["Okay, but if anyone asks, you're with ME. I don't want to risk losing my street cred.", "William"]];
                
                case UnknownEnum.Value_14:
                    return [["I dunno what you like, but pink lemonade seems fitting for a positively pink lady.", "Mary"], ["Mary, Mary... Why do you dress so so sadly? Wouldn't you rather dress happy?", "Elizabeth"], ["Life ain't all cupcakes and ice cream. What if you need to sneak around in the dead of night from zombies, or vampires, or serial killers?", "Mary"], ["Those glittery eyes of yours would give you away like a flare.", "Mary"], ["I look like a shadow. My green even could fade into the grass like camouflage. I'd NEVER get caught.", "Mary"], ["Oh, but daddy says all people who dress in black are sad sad kids with parents who don't love them...", "Elizabeth"], ["Did your mommy and daddy not love you?", "Elizabeth"], [".....", "Mary"], ["...You don't get the lemonade anymore I'm drinking it.", "Mary"], ["What!? No, give that back!!", "Elizabeth"]];
                
                case UnknownEnum.Value_15:
                    return [["Hey, Cass, you mind if I vent a little?", "Mary"], ["There's something that's been picking at my brain.", "Mary"], ["Huh? Oh! Sure, go ahead! I know this can all be a lot, but I'm here for you!", "Cassie"], ["Thank you, very touching. So...", "Mary"], ["...The names flying around for this place are really stupid, right?", "Mary"], ["...I'm sorry?", "Cassie"], ["Don't be. But like, this is hell. We're in hell. We've HAD a term for it.", "Mary"], ["I don't see why we need to call it something like \"Pizza Perdition\", or \"Eenus and Beenus' House of Weenus\".", "Mary"], ["Have people actually been calling it that?", "Cassie"], ["I 'unno. I wouldn't be surprised, though.", "Mary"], ["Well, I don't blame them. It's a scary situation, so it helps to put people at ease, y'know? It's like coming up with songs while you work!", "Cassie"], ["...I don't see why you WOULDN'T wanna be in hell, but whatever makes you happy.", "Mary"], ["...What have YOU been calling it?", "Mary"], ["Oh, I've heard a couple. Let's walk and talk!", "Cassie"]];
                
                case UnknownEnum.Value_9:
                    return [["You're that Billy guy, right? I heard you like watching TV too.", "Mary"], ["A fellow screensurfer? Billy perked up and smiled! How nice!", ""], ["You watch, uh, Spectral Scoopers? I like that show. It's good.", "Mary"], ["Three guys go around and hunt ghosts on camcorders. It's kinda low budget.", "Mary"], ["Billy scowled and waved away the notion. Live action shows aren't really his forte.", ""], ["No? Lame. What about Immortal and the Restless?", "Mary"], ["That show's for old people but it's kinda funny when nothing else is on.", "Mary"], ["Billy's hand tilted so-so. It's alright...", ""], ["Billy's hand raised up over his shoulder. He's a peruser of finer cartoons.", ""], ["Uh, I'm not catching your drift.", "Mary"], ["Billy punches his open palm, then bumps his closed fists together, gesturing towards a television hanging from the ceiling.", ""], ["He looks wistfully at a clock hanging behind the counter. Hands extending outwards, Billy awaits a reply.", ""], ["...We're gonna have to walk and talk, or else we're gonna be here all day.", "Mary"]];
                
                case UnknownEnum.Value_18:
                    return [["Why did they make you like that?", "Mary"], ["My exterior unit?", "Strings"], ["No, no, I get that. You're like a spider, it's cool.", "Mary"], ["I mean your whole...neurotic breakdown thing.", "Mary"], ["You'd think a robot designed for security would pack a punch, right?", "Mary"], ["My schematics were not manufactured with defense in mind!", "Strings"], ["...Not traditionally.", "Strings"], ["My aim is to be a MONITOR! Watch. TRACK! ANALYZE!", "Strings"], ["All manageable with my motherboard overclocked with PURE PANIC!", "Strings"], ["But why panic of all things?", "Mary"], ["Heh. Are you like, scared they're gonna fire you?", "Mary"], ["My production was overseen by Fritz! Glade. Fritz Glade. Not the other one.", "Strings"], ["Though designed for home use, I was quickly altered for security purposes!", "Strings"], ["In order to adapt to his needs, he allowed my programming to be influenced by a series of emotions.", "Strings"], ["Paranoia! Dread! Envy!", "Strings"], ["...It's why I'm able to be disappointed in myself.", "Strings"], ["...This isn't funny anymore. Let's get out of here.", "Mary"]];
                
