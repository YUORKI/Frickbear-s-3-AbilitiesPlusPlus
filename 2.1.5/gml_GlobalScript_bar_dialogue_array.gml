                case UnknownEnum.Value_14:
                    return [["Uh, h-hey, kid? You're...", "Hudson"], ["...Gulp... Your dad's that creepy tall dude with the mustache, right?", "Hudson"], ["Look, I...I don't know how to tell you this, but I don't think that guy's a very good person.", "Hudson"], ["Oh, please! Father wouldn't hurt a fly!", "Elizabeth"], ["...Well, unless the fly provoked him. In which case, he's rightfully defending himself!", "Elizabeth"], ["Or if the fly had done something to DESERVE it...well, then he's just doing the right thing!", "Elizabeth"], ["He tells me most flies are ontologically evil, you know. Really, he's doing us ALL a favor.", "Elizabeth"], ["...My god, some parents really are just the worst.", "Hudson"]];
                
