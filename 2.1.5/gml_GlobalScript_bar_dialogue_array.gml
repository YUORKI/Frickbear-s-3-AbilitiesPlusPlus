                case UnknownEnum.Value_10:
                    return [["Thank you. Your kindness touches this old man's heart.", "Henry"], ["Tell me, if I may pry a little... What do you make of the Flipside?", "Henry"], ["He's gotta get out of here, that's what! Billy pulled down on his cheeks in frustration.", ""], ["More restless to leave than the rest, are you? I can relate.", "Henry"], ["I've a task I must complete. Or, atleast, I have to try...", "Henry"], ["Do you have something of utmost importance waiting for you too?", "Henry"], ["He thought of the DVD box set that he sought after so dearly...Billy nodded.", ""], ["It's nice to have another who understands how I feel.", "Henry"], ["We've both got no time to waste...", "Henry"], ["...So I do believe a team up is in order.", "Henry"]];
                
                case UnknownEnum.Value_11:
                    return [["A pleasure to see you, other William.", "William"], ["Tell me, do you have any relatives? Siblings, offspring, anything of the sort?", "William"], ["Billy pulled his head up from the glass and shook his head.", ""], ["Consider yourself lucky. Family is little more than an irritation! ...If they're not sending you money.", "William"], ["Unfortunately, with my two sons and daughter I'm a bit of a family guy myself.", "William"], ["Billy's eyes widened, his heartbeat quickened. He turned slowly to William.", ""], ["...What's with that look? You want to hear about my children, do you?", "William"], ["Billy smiled and nodded.", ""]];
                
