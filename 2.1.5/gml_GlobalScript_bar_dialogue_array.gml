                    return [["Tch. Nice try, mutt! You aren't gonna wiggle your way out of this with some cheap booze!", "The Boss"], ["...Have I even seen your ugly mug before?", "Sally"], ["Bah, don't play dumb with me! I know your grift!", "The Boss"], ["Your lousy playhouse is run by a buncha PLAGIARISTS!!", "The Boss"], ["...Come again?", "Sally"], ["MY MICROGAMESES!! YOU RIPPED OFF MY MICROGAMSES!!", "The Boss"], ["I'll have you know my company has a PATENT on those! And we're gonna be happy to SUE YOU CHUMPS INTO THE GROUND!!", "The Boss"], ["Pssh, easy! You know that junk wasn't even new when YOU came up with it, right?", "Sally"], ["WHY YOU- Eh?", "The Boss"], ["Word on the grapevine is you got the idea from that plumber's game, isn't that right?", "Sally"], ["But because his never made it to the states, you thought you could pass it off as your own, easy as that.", "Sally"], ["...", "The Boss"], ["Hey, listen, your secret's safe with me!", "Sally"], ["...So long as you come along. You look like you'd make a good meat shield.", "Sally"]];
                
                case UnknownEnum.Value_16:
                    return [["Here, take th-", "Sally"], ["YEEEEAAAAAGH!! AAAAAAAAAAAAAGGHHH!!", "Hudson"], ["I KNEW IT!! I KNEW IT!! THIS PLACE ISN'T SAFE!!", "Hudson"], ["I TOLD YOU ALL THE SEXY BIRD WAS JUST TO LULL US INTO A FALSE SENSE OF SECURITY!!", "Hudson"], ["THE ANIMATRONICS ARE COMING FOR US ALL!! THEY'RE CORNERING US WHILE WE'RE DEFENSELESS!!", "Hudson"], ["AAAAAAAAAAAAAAAAAAGH-", "Hudson"], ["You grab his head and hold his mouth shut.", ""], ["PIPE. DOWN.", "Sally"], ["I'M ON YOUR SIDE.", "Sally"], ["Now shut your trap, and we're going to help each other escape, capiche?", "Sally"], ["Hudson blinks.", ""], ["...He begins to nod slowly.", ""]];
                
                case UnknownEnum.Value_18:
                    return [["CURIOSITY! This texture...plastic? No. METALLIC! A fellow AUTOMATON!", "Strings"], ["Relations to bar...relations to establishment...A FELLOW ESCAPIST!", "Strings"], ["AUGH! You're yelling right in my audio proc- My ear. You're yelling in my ear.", "Sally"], ["And back off, man! You're...", "Sally"], ["...Okay no offense, but you're horrible to look at.", "Sally"], ["Offense TAKEN, but your rudeness is completely coherent.", "Strings"], ["I was built to be efficient. Pragmatic! EFFECTIVE!", "Strings"], ["My outer shell has only the necessities, and minimal needless accessories!", "Strings"], ["I noticed. You're a lot more skin and bones than yours truly.", "Sally"], ["INVALID! My shell contains only artificial materials, much like your snowy silk-like fur!", "Strings"], ["...Are you hitting on me?", "Sally"], ["NO! ERRONEOUS, NULL, COMPLETELY VOID! THIS UNIT CANNOT MAINTAIN A CONNECTION BEYOND 200 MBPS!", "Strings"], ["...Okay nevermind you're hilarious. You're coming with me.", "Sally"]];
                
                default:
                    return bar_dialogue_array(-1, arg1);
            }
        
        case UnknownEnum.Value_20:
            switch (arg1)
            {
                case UnknownEnum.Value_3:
                    return [["Well I'll be damned! I never expected the grim reaper to embrace the concept of Happy Hour!", "Fritz"], ["...Damned indeed, though I am no reaper.", "OMC"], ["I am the same as you, a spirit doomed to entertain these lands and their whims.", "OMC"], ["Oh, PLEASE! Don't bother trying to pull my leg! It's bound to pop out by now...", "Fritz"], ["This place is like a living nightmare of a daydream, and one I'm MORE than welcome to endure!", "Fritz"], ["But you? You must be HANKERING for a change of scenery!", "Fritz"], ["If you've been here for as long as you say, it's been nothing but reds all over!", "Fritz"], ["Maybe you'd do well with a nice shade of green? Complimentary colors, and whatnot!", "Fritz"], ["In passing I have dreamt of a life outside these halls, but I've not the resolve to take it.", "OMC"], ["Through trial after trial, I've seen so many walk through this realm.", "OMC"], ["I know my duty is one that is sound. One that is needed.", "OMC"], ["...For this is repentance for a lifetime I wish to bury deep, deep under the thrashing waves.", "OMC"], ["It's only natural I might succumb to the tides.", "OMC"], ["...I'd have thought that a ferryman like yourself would have a bit more persistence than that!", "Fritz"], ["My fashionably unfavorable friend, you've taken up a great task indeed...", "Fritz"], ["But it's a task with DIDDLY SQUAT when it comes to substance!", "Fritz"], ["It boggles the mind, what DO you hope to achieve?", "Fritz"], ["Peace of mind. A mind unthinking. To allow myself the glories of such an undertaking...", "OMC"], ["To live in the falsehoods that I might find repentance for my actions.", "OMC"], ["That's EXACTLY what I'm talking about!", "Fritz"], ["You're aiming for an action but not a goal! You've no clue what would be atonement, do you?", "Fritz"], ["...Such boisterous preaching, and for who?", "OMC"], ["You'd be best not to-", "OMC"], ["I'd be best not to do a lot of things, but this I'm certain of!", "Fritz"], ["If you truly aim to better yourself, then you should be doing the same as me!", "Fritz"], ["FIGHTING THE ODDS! TACKLING DANGER! DYING TODAY SO WE CAN SEE TOMORROW!", "Fritz"], ["And Tipsy put DOWN that broom, I'm on a roll, baby!", "Fritz"], ["...I just want people to stop yelling in my bar.", "Tipsy Bird"], ["You've enveloped yourself in an ouroboros of self-loathing!", "Fritz"], ["So much to the point you've convinced yourself to...", "Fritz"], ["WHAT? Wade through misery while the world's waiting at the door?", "Fritz"], ["There's no point to this loop-de-loop facade of \"redemption\" if you don't realize WHO it's for!", "Fritz"], ["You're so caught up in rEdEmPtIoN, you fail to understand what the very word means!", "Fritz"], ["It's not through suffering in twisted solace you might see tomorrow!", "Fritz"], ["It's through putting it all on the line, and letting it ride!", "Fritz"], ["And you'll be remiss to think you'd meet a luckier son of a gun than me!", "Fritz"], ["So JOIN me in my CRUSADE, so that we might CONQUER the other side!", "Fritz"], ["...Hmph.", "OMC"], ["You speak too much. I couldn't argue if I wanted to.", "OMC"], ["That's the goal! Now C'MON! The Angel's got repentance with YOUR name on it!", "Fritz"]];
                
                case UnknownEnum.Value_4:
                    return [["...We've met before, haven't we?", "Michael"], ["A thousand times over, yes. Though not once have we had the pleasantries of introducing ourselves.", "Old Man"], ["Michael. Michael Afton.", "Michael"], ["It is a pleasure, Michael. I am Old Man Consequences.", "Old Man"], ["...That's more of a title, is it not?", "Michael"], ["My true name was lost, long ago. Taken by the tides of retribution and comeuppance.", "Old Man"], ["I am known as all that I deserve. The consequences of what I have done.", "Old Man"], ["Consequences. A concept I am far too familiar with.", "Michael"], ["You are not alone in your endeavors, no matter how things may seem.", "Michael"], ["I've lost...more than everything because of my actions.", "Michael"], ["It's for those same reasons I stand beside you now.", "Michael"], ["Yes...A curse in of itself, I'm sure.", "Old Man"], ["To some, yes. To others, a gift.", "Michael"], ["But to me? A chance at redemption.", "Michael"], ["One that I do not deserve, but one I shall welcome with open arms.", "Michael"], ["To let go of this chance would be disrespectful to those who will never know the same.", "Michael"], ["It's rare to meet a wayward soul such as myself, Michael. One who has sunken in the same horrid depths.", "Old Man"], ["One should find it sickly that I'm happy to hear of your plights.", "Old Man"], ["Because it means you are not alone. Not anymore.", "Michael"], ["Come. I've more than a few questions for you.", "Michael"], ["...And answers I will supply.", "Old Man"]];
                
                case UnknownEnum.Value_7:
                    return [["Dude, I know what you are!", "Frank"], ["...Ah?", "Old Man"], ["You're the tutorial old man!", "Frank"], ["...In a...sense?", "Old Man"], ["I'll have to implore you to elaborate.", "Old Man"], ["Mysterious old man, sometimes in a cloak...", "Frank"], ["Heck, you even help everyone get their bearings when they show up!", "Frank"], ["You're totally like, LIKE a tutorial old man!", "Frank"], ["And uh, that's a good thing, to be clear!", "Frank"], ["So you say.", "Old Man"], ["And y'know what? A decent amount of the time they turn out to be SUUUUPER strong!", "Frank"], ["I bet you've got some baller tricks up your sleeves!", "Frank"], ["I stand before you a simple man. I have not but my fishing rod to cast and my lantern to guide.", "Old Man"], ["Hey, all I've got is my broom! From where I'm sitting, you're bursting with potential!", "Frank"]];
                
                default:
                    return bar_dialogue_array(-1, arg1);
            }
        
        default:
            switch (arg1)
            {
                case UnknownEnum.Value_0:
                    return [["...Oh, thank you! ...Er, it's cold, right? Just checking!", "Jeremy"], ["MmmMmmMmmm...Dee-licious! Treats are always sweeter after a rough patch.", "Jeremy"], ["Is it okay if I come with you? I can repay the favor, I promise you!", "Jeremy"], ["Whatever you need help with, I'll be there to get you through it!", "Jeremy"]];
                
                case UnknownEnum.Value_1:
                    return [["...Ah, thanks. God knows I could use a drink right now.", "Mike"], ["I'm surprised this isn't hell, to be honest with you. Can't think of a worse fate than working here for all of eternity...", "Mike"], ["...And even worse, I can't afford another drink until I go back out there.", "Mike"], ["...But I guess that's all the more reason to find a way out, huh?", "Mike"], ["Alright, alright. I've sat around long enough. Let's get moving.", "Mike"]];
                
                case UnknownEnum.Value_2:
                    return [["...O-Oh! I appreciate that. Er, thank you.", "Vanessa"], ["It's a shame they don't have coffee here...I could really use it for shifts as rough as these.", "Vanessa"], ["Er...rounds? I think that's what they're called in here.", "Vanessa"], ["Sorry, sometimes being in here really doesn't feel any different from being out there...", "Vanessa"], ["...Ah well. No matter where we are, we've got a job to do. So let's make it a good job!", "Vanessa"]];
                
                case UnknownEnum.Value_3:
                    return [["...EH!? Oh, thank you!", "Fritz"], ["Yes, one must always remember to get positively smashed before tackling the concept of their own mortaility!", "Fritz"], ["Well...POST-mortality.", "Fritz"], ["Now, if only I could crack PRE-mortality, then I'd be onto something...", "Fritz"], ["Well, there's nothing like adrenaline to shake off the rigor mortis! Let's get out of here, shall we?", "Fritz"]];
                
                case UnknownEnum.Value_4:
                    return [["...Oh. Thank you.", "Michael"], ["Quite the curious predicament we've found ourselves in, hm?", "Michael"], ["Not quite alive, yet not quite dead...as if neither life nor death will accept us.", "Michael"], ["...Well, I suppose that's not an entirely new feeling for myself.", "Michael"], ["...But I've too much to lose to simply give up now.", "Michael"], ["If we've even a ghost of a chance of crawling our ways out of here, then...", "Michael"], ["...Why don't we do it together?", "Michael"]];
                
                case UnknownEnum.Value_5:
                    return [["D'awww, you shouldn't have! You really know the way to a girl's heart, don't you?", "Vannabelle"], ["...Or at least you would if I drank. Ha!", "Vannabelle"], ["Don't worry, don't worry...if those animatronics you're dragging around are any indication, I can tell you're somethin' special.", "Vannabelle"], ["And I'd have to be a real JERK to not repay you somehow... So c'mere, let me give you a kiss!", "Vannabelle"]];
                
                case UnknownEnum.Value_8:
                    return [["...Eh? Do I smell...FREE BOOZE!?", "The Boss"], ["Well, don't mind if I do! Wahahahaha!", "The Boss"], ["I tell you, chump, as much as I liked the cheap drinks at first, being dead is getting old - FAST!", "The Boss"], ["I've got a business to run! Bah, does the jerk who's running this place know who I am!?", "The Boss"], ["I'm the guy who's gonna STOMP THEM INTO THE GROUND, that's who!", "The Boss"], ["So COME ON! Let's MOVE IT!!", "The Boss"]];
                
                case UnknownEnum.Value_10:
                    return [["...Ah. Thank you for the drink.", "Henry"], ["You know, I don't seem to recognize you...", "Henry"], ["However, I...feel I should apologize. I can't help but feel partially at fault for you being here.", "Henry"], ["At first, I thought this was my own personal hell...yet it seems it's far more than just me who got dragged into this.", "Henry"], ["Yet...part of me still believes there's a way out, if only we search for it. That what seems to be a dead end is just yet another path.", "Henry"], ["...And frankly, I'm in no mood to give up now. If you'll lead the way out...", "Henry"]];
                
                case UnknownEnum.Value_11:
                    return [["Well well! About time someone recognized their betters.", "William"], ["Oh, what's with that look? Not quite used to this whole death thing, are you?", "William"], ["Pah, you should know this is all just a minor setback. A timewaster!", "William"], ["There's an exit somewhere in here...I just know it. Try as they might, they won't keep me down here for long.", "William"], ["After all...I ALWAYS come back!", "William"], ["...", "William"], ["...You're ruining the moment. Get a move on, you dolt!", "William"]];
                
                case UnknownEnum.Value_6:
                    return [["...Hm? Oh, you didn't have to buy me nothin'. Thanks, though.", "Clark Fixy"], ["Y'know, slacking off can be nice and all...but I've been doing it for too long. I'm fixin' to get some work done!", "Clark Fixy"], ["For your sake and mine, let's try to make this quick, eh?", "Clark Fixy"]];
                
                case UnknownEnum.Value_7:
                    return [["Ohh, heck yeah! Thanks a lot, dude! This is just the power-up I needed!", "Fredsweeper Frank"], ["For completing my sidequest, you've earned...", "Fredsweeper Frank"], ["Doot-dododoo, Fredsweeper Frank has joined your party! Let's go sweep those bots off their feet!", "Fredsweeper Frank"]];
                
                case UnknownEnum.Value_19:
                    return [["Eh? Look, I'm not that kinda pooch here, pal. Get lost.", "Sally"], ["...But, uh, I appreciate it. Beats having to pay the tab myself.", "Sally"], ["...Not half bad. I'd prefer something with a bit more of a 'shock', ya know? But eh, can't complain.", "Sally"], ["...Well, I guess I owe you one now, right?", "Sally"], ["Lead the way. Whatever you need, I'll get it done.", "Sally"]];
                
                case UnknownEnum.Value_16:
                    return [["ACK!! B-Back off!", "Hudson"], ["Whew...D-Don't scare me like that! You can't just...Jump up next to a guy!", "Hudson"], ["...Oh, that...That drink is for me?", "Hudson"], ["I think...I think I'm good. But, um. S-Sorry for snapping, I guess. I-It's hard not to be a little high strung around here.", "Hudson"], ["Ugh, and does no one else feel how hot it is? I'm burning up in here...", "Hudson"], ["...", "Hudson"], ["...What? You want me to come with you?", "Hudson"], ["I mean... Sure? I guess? It's not like I have anything better to do.", "Hudson"]];
                
                case UnknownEnum.Value_18:
                    return [["BAR!...Glass?...Liquid...!", "Strings"], ["...THANK YOU! Thank you. It's much appreciated.", "Strings"], ["Although I am incapable of consuming liquid, your kindness is-", "Strings"], ["Wait. Wait. WAIT!", "Strings"], ["Kindness. Compassion? GENEROSITY?!", "Strings"], ["These calculations- they're UNFACTORED! UNPRECEDENTED! UNHEARD OF!", "Strings"], ["Oh dear, oh dear! Who knows what this could've changed?! My simulations could be WAY off now!", "Strings"], ["You MUST take me with you to re-examine every possibility, or else this drink could be my last!", "Strings"]];
                
                case UnknownEnum.Value_9:
                    return [["Billy leaned in to look at the drink he'd been offered. He picks it up...", ""], ["...And swigs it down in just a few gulps! He leaned back satisfied.", ""], ["Setting the drink down on the counter, Billy smiled and extended his hand in gratitude. It seems he wants to come along with you!", ""], ["After all...What could POSSIBLY go wrong?", ""]];
                
                case UnknownEnum.Value_17:
                    return [["...Stupid \"underage drinking\" laws...stupid \"responsible adults\"...stupid \"bar\"...", "Mary"], ["...Oh, finally! Free beer! I knew sitting around irresponsible drunkards like you would pay off eventually.", "Mary"], ["Eugh! Tastes just like...", "Mary"], ["\"Fazberry Blast\"? \"NON-ALCOHOLIC\"!?", "Mary"], ["...Figures.", "Mary"], ["Well, if I'm not going to get drunk, I might as well do something to get the dead heart pumping. Let's get out of here.", "Mary"]];
                
                case UnknownEnum.Value_12:
                    return [["Oh! Well, I don't like drinking quite as much as my business partners, but...", "Edwin"], ["...Perhaps something to ease the nerves is just what I need. Being trapped in this horrible place has my head spinning!", "Edwin"], ["I don't deserve to rot in this place... Sure, maybe I wasn't flawless, but...", "Edwin"], ["...Regardless, I suppose all I can do is try to escape. And this liquid courage should be just what I need to do so!", "Edwin"], ["And, a little business tip from me to you...", "Edwin"], ["It's bad business to not reimburse investors!", "Edwin"]];
                
                case UnknownEnum.Value_13:
                    return [["...Oh! Well, thank you! It's refreshing to see a friendly face in a place like this.", "Fiona"], ["It's...certainly a strange feeling being here. I've put together plenty of haunted houses in my time, but this place...", "Fiona"], ["...Seeing so many of my own characters twisted into something terrible...", "Fiona"], ["...Well, it's...unsettling, to say the least!", "Fiona"], ["But I still believe I can get through it... WE can get through it, if we stick together! So c'mon, let's get moving!", "Fiona"]];
                
                case UnknownEnum.Value_15:
                    return [["Oh, hey! Are you a technician? My dumb mask isn't working anymore...", "Cassie"], ["I've filled out like, THREE playmats waiting for someone who can fix it to show up.", "Cassie"], ["Agh...Man, I'm really gonna have to keep doing all these trials, aren't I...?", "Cassie"], ["I was REALLY hoping I'd just be able to walk through walls like I normally do with this thing...", "Cassie"], ["...Oh, but, uh, thanks for the juice!", "Cassie"], ["Maybe I won't need shortcuts as bad if I've got someone to take the journey with me?", "Cassie"], ["More than anything...I think I could use a friend down here.", "Cassie"]];
                
                case UnknownEnum.Value_14:
                    return [["...Oh, thank you for the fruit juice! This kind is my favorite!", "Elizabeth"], ["...Oh...but father told me I shouldn't accept gifts from strangers...", "Elizabeth"], ["...Though then again, father isn't watching, is he...?", "Elizabeth"], ["...Heehee. Well, I hope he doesn't mind if I get up to a LITTLE mischief!", "Elizabeth"]];
                
                case UnknownEnum.Value_20:
                    return [["With a delicate plink, the glass is placed next to the man.", ""], ["He doesn't take note of it, at first, but slowly gathers himself as he rises from his seat", ""], ["Ah...", "Old Man"], ["Yes.... Yes. I supposed I've sat idly long enough.", "Old Man"], ["Thank you for this boon. It means more than you or I will ever know.", "Old Man"], ["...Now let us not dawdle. We will not get another chance like this one.", "Old Man"], ["You watch as his tail slides across the floor, completely abandoning the drink you bought for him.", ""], ["...I'll put it on his tab.", "Tipsy Bird"]];
                
                default:
