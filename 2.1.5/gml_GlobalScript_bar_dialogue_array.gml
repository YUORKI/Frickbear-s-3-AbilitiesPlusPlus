                    return [["Thank you, Mr...Mr...", "Vanessa"], ["...Sorry, It's on the tip of my tongue. Started with an...H?", "Vanessa"], ["H...Ha...Hu...Hubert?", "Vanessa"], ["Hudson! M-my name is Hudson.", "Hudson"], ["Yes, thank you.", "Vanessa"], ["...You know, technically, employees aren't allowed to wear their hats backwards.", "Vanessa"], ["Like, it's in the employee handbook, but...Who's gonna enforce such a stupid rule?", "Vanessa"], ["Aside from, y'know, the higher-ups.", "Vanessa"], ["The more employees we lose, the more they expect the remaining to pick up the slack...", "Vanessa"], ["And yet they're still eager to hand out pink slips. I don't know what they're after.", "Vanessa"], ["...Th-There's an employee handbook?", "Hudson"], ["...AM I THE ONLY ONE WHO'S EVER READ IT?!", "Vanessa"], ["Alright, let's walk and talk. I'll catch you up to speed.", "Vanessa"]];
                
                case UnknownEnum.Value_5:
                    return [["H-Hey, uh...I-I got this for...y-you...", "Hudson"], ["Oh! Well, thank you!", "Vannabelle"], ["AHNOGODPLEASEDON'THURTME!", "Hudson"], ["Hey, hey! Easy! You don't have anything to be afraid of! Not...", "Vannabelle"], ["...Not anymore, at least.", "Vannabelle"], ["...Ah, phew! I was worried you were gonna pull a knife on me or something, ahahaha!", "Hudson"], ["Hey! I'm...I'm not like how I was back at the Pizzaplex, alright?", "Vannabelle"], ["...The Pizzaplex?", "Hudson"], ["...That's where you knew me from, right?", "Vannabelle"], ["N-No! You were...ugh...", "Hudson"], ["YOU WERE THE WEIRD GIRL FROM FAZBEAR'S FRIGHTS!!", "Hudson"], ["O-Oh!", "Vannabelle"], ["...What? I never did anything particularly weird THERE...", "Vannabelle"], ["...Well, aside from coming in a little too often, I guess? AND hogging the arcade cabinet, but...", "Vannabelle"], ["No, no! That's EXACTLY it! You're the ONLY person who ever played that cabinet!", "Hudson"], ["Oh, and THAT makes you think I'd pull a knife on you?", "Vannabelle"], ["NO SANE PERSON WOULD EVER WILLINGLY PLAY HARE PAIRS!", "Hudson"]];
                
