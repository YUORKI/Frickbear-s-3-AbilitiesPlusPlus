                    return [["...Ah. Henry.", "Michael"], ["Hello, Michael. I...can't say I'm surprised to see you here, knowing the nature of our work.", "Henry"], ["Indeed, indeed...but should the Angel see fit, hopefully that work won't go unfinished.", "Michael"], ["...How about yourself? I take it you weren't able to finish your investigation, given you're here.", "Michael"], ["Oh, no, no, I made great strides in my investigation, that's exactly the problem.", "Henry"], ["That missing piece I was looking for wound up being what sent me here.", "Henry"], ["...I suppose that tracks. I did warn you that this was the only way your path could reasonably end.", "Michael"], ["And the other path would've left six innocent children still trapped within my machines for the rest of my waking life.", "Henry"], ["Michael, perhaps you're content to only patch up what personally concerns you, sitting idly by as all the rest suffer...", "Henry"], ["...But I won't. I won't rest until everything - EVERYTHING is made right.", "Henry"], ["Such ambition rarely comes to fruition, Mr. Emily.", "Michael"], ["...Though I suppose all either of us want is to sleep well at night again.", "Michael"], ["Very well then. Here's to seeing our respective duties to their end.", "Michael"], ["...And putting all those who need it most to rest.", "Henry"]];
                
                case UnknownEnum.Value_6:
                    return [["...Henry?! Henry! My god, you're a sight for sore eyes!", "Clark"], ["Ah, Clark! ...It's nice to know that even here, there's someone I can trust.", "Henry"], ["How long has it been for you?", "Henry"], ["A...year, maybe? I don't know...", "Clark"], ["But didn't you...Didn't you WANT to move on? I thought...", "Clark"], ["Clark, discard whatever notions you have for my fate.", "Henry"], ["I've a task of great importance, and an enemy of greater strength.", "Henry"], ["I'm gonna need someone willing to get their hands dirty. Someone who can throw a wrench into a well knit plan.", "Henry"], ["...As my best mechanic, are you ready to help me fix this?", "Henry"], ["Just lead the way and I'll follow.", "Clark"], ["...Whatever it takes to end this company.", "Clark"]];
                
                case UnknownEnum.Value_5:
                    return [["It breaks my heart to see how many have suffered in that devil's wake...", "Henry"], ["...I hope that this gesture, albeit small, can act as some small form of solace.", "Henry"], ["...", "Vannabelle"], ["...Ah, my apologies. I understand it must be a sensitive subject.", "Henry"], ["Nono, it's not that! It's just...", "Vannabelle"], ["...Do I know you?", "Vannabelle"], ["...Henry Emily?", "Henry"], ["...", "Vannabelle"], ["...William Afton's business partner.", "Henry"], ["OH! Oh, yeah! Yeah, I think I've heard of you!", "Vannabelle"], ["Sorry, you might've just been a bit before my time!", "Vannabelle"], ["(I didn't die THAT long ago...)", "Henry"]];
                
                case UnknownEnum.Value_8:
                    return [["BAH!! OVERALLS!! I already gave you your castle back, what more do you want!?", "The Boss"], ["I-I'll give you gold coinses! I'll give you garlic! I'll even give you the giant statue of yourself back! Just please, don't stomp me again!!", "The Boss"], ["...Come again?", "Henry"], ["...Oh, bah. You're not him. This booze is making me see funny!", "The Boss"]];
                
                case UnknownEnum.Value_11:
                    return [["Oh? Finally recognized my brilliance, Henry?", "William"], ["William, you are a pathetic man who is worth less than the gum stuck under my shoe.", "Henry"], ["But you are cunning, and you are skilled at what you do.", "Henry"], ["Your skills will be of great use to my escape the Flipside. Nothing more, nothing less.", "Henry"], ["Excuse me, \"The Flipside?\" Is that seriously the best you could come up with?", "William"], ["Why, I've got a far better name! The Underworld of Ceaseless/Contemptable Nuisances!", "William"], ["Far more accurate, if you ask me! That's all this place is! Nuisance after nuisance after-", "William"], ["The Flipside is elegant, and fittingly mysterious.", "Henry"], ["But THAT name does suit you, William. Classless and utterly childish.", "Henry"], ["Classless? Oh, this is about my facial hair again, isn't it? You're just jealous of my-", "William"], ["Do you want to get out of here, or shall I leave you to your temper tantrum?", "Henry"], ["...Pah. To hell with it.", "William"]];
                
                case UnknownEnum.Value_12:
                    return [["AGH! HEN! ER, M-MR. EMILY!", "Edwin"], ["I-I promise I'll get the Fazbear project done, just give me a little more time! Please!", "Edwin"], ["Edwin, relax! I mean nothing more than a bit of goodwill from an old business parter...", "Henry"], ["...And more importantly, an old friend.", "Henry"], ["You...mean it?", "Edwin"], ["Phew, oh man! I was worried I was really in for it! You're...really not mad?", "Edwin"], ["It would be hard to after all these years.", "Henry"], ["...Besides, for what work your company DID finish for us...you did well.", "Henry"]];
                
                case UnknownEnum.Value_13:
                    return [["Ah, Mr. Emily! It's...Well, it's good to see you!", "Fiona"], ["Mrs. Murray! I hope this hell of my own creation hasn't been too hard on you.", "Henry"], ["Well, seeing as my characters are skipping to and fro, I suppose my hands aren't entirely clean...!", "Fiona"], ["Er...Yes, well....", "Henry"], ["...I hope you aren't troubled by the design alterations we made to your characters over the years.", "Henry"], ["Oh, no! Not at all! Seeing all the interpretations of the designs has been a delight!", "Fiona"], ["...Though, you two sure messed around with Chica's body shape a lot, huh?", "Fiona"], ["If memory serves, Chica's designs always garnered twice as much feedback than her 3 bandmates combined.", "Henry"], ["Customers are quite particular about their animatronic birds.", "Henry"], ["...Well, audiences CAN be fickle.", "Fiona"]];
                
                case UnknownEnum.Value_9:
                    return [["...Billy stares you down, seemingly looking over your attire.", ""], ["...Ah? Sir, do you have something you wish to say to me?", "Henry"], ["...Something about the way I dress, I presume?", "Henry"], ["The man seems adept at understanding those who can't quite speak, Billy thought.", ""], ["Billy glided a hand across his chin, pulled off invisible straps from his shoulders, and ran a hand back the top of his head.", ""], ["...You want me to...", "Henry"], ["Shave my beard, ditch the overalls, toss the hat and slick back my hair?", "Henry"], ["I, ehm...don't think that's negotiable, I'm afraid.", "Henry"], ["Deflated, Billy slumped into his chair.", ""], ["Now, now...This is no time to be moping, don't you think?", "Henry"], ["Chin up! I'm sure you'll find the man you're looking for someday.", "Henry"], ["For... Whatever you wanted me to do that for.", "Henry"]];
                
                case UnknownEnum.Value_14:
                    return [["Oh, Uncle Henry! Uncle Henry!", "Elizabeth"], ["Hello, Elizabeth. I...must apologize for allowing you to end up here.", "Henry"], ["Despite me working side by side with him for so long, my vision became...clouded.", "Henry"], ["I was so blinded by my work that I couldn't even see the monster right beside myself.", "Henry"], ["I know a simple lemonade isn't enough to make up for all you must've gone through...", "Henry"], ["But I promise you Elizabeth. I will make it up to you, to everyone.", "Henry"], ["Oh, it's okay, Uncle Henry! I only have myself to blame, after all... I disobeyed my father's orders!", "Elizabeth"], ["I was naughty, and I paid the price. It's my fault.", "Elizabeth"], ["(...My god, William. What kind of morals were you teaching your children?)", "Henry"], ["...Elizabeth, none of this is your fault. You have to understand. No good parent would put you in that kind of danger.", "Henry"], ["...But...daddy told me you left YOUR daughter to...", "Elizabeth"], ["...", "Henry"], ["...Oh, I'm sorry, Uncle Henry! I didn't mean to hurt your feelings!", "Elizabeth"], ["It's...fine, really.", "Henry"], ["Listen, why don't we stick together? I'd hate to see one of these machines hurt you again.", "Henry"], ["Well, father probably WOULD be upset with me if I let that happen...so sure!", "Elizabeth"], ["...Oh, Elizabeth...", "Henry"]];
                
                default:
                    return bar_dialogue_array(-1, arg1);
            }
        
        case UnknownEnum.Value_11:
            switch (arg1)
            {
                case UnknownEnum.Value_1:
                case UnknownEnum.Value_2:
                    return bar_dialogue_array(arg1, arg0, true);
                
                case UnknownEnum.Value_0:
                    return [["Why, you're rather haggard. Are my animatronics to blame?", "William"], ["They tend to have minds of their own... among other things.", "William"], ["Oh, the bandages? No, that was something else, heh...", "Jeremy"], ["So your frontal lobe is intact?", "William"], ["What was that?", "Jeremy"], ["Nothing, nothing!", "William"], ["Say, lad... Care to, erm, take a leisurely stroll with me?", "William"], ["I don't see why not!", "Jeremy"]];
                
                case UnknownEnum.Value_3:
                    return [["BILL!! Based on our brief encounter in the mortal world, I thought you HATED me!", "Fritz"], ["Oh, BELIEVE ME, you flea-ridden freak, I most certainly DO.", "William"], ["...But, alas...you possess a skill not a single other person in this blasted place seems to have.", "William"], ["My knife-juggling skills? My knowledge of advanced pyrotechnics?", "Fritz"], ["MY ABILITY TO CLIP MY TOENAILS WITH NOTHING BUT MY OTHER TOENAILS!?", "Fritz"], ["...Someway, somehow, you seem to always narrowly escape the jaws of every single one of my creations.", "William"], ["What's your secret?! What FLAW must you be exploiting?! I MUST see it with my very own eyes!", "William"], ["And, most importantly, once I do...", "William"], ["...I must return to the mortal realm and correct them, to ensure you will never make a mockery of my machines again.", "William"], ["What do you say? I can conduct my research, and you can do...whatever it is you do.", "William"], ["Do we have a deal?", "William"], ["A deal with the devil? Oho, Bill, my boy!", "Fritz"], ["That'd be my theological DREAM!", "Fritz"]];
                
                case UnknownEnum.Value_4:
                    return [["Oh Michael! How about a cold drink for my FAVORITE child?", "William"], ["...That's a sorry lie, even for you.", "Michael"], ["What are you doing here? Surely you've found someone else to subjugate by now.", "Michael"], ["Sheathe your tongue, child! I only seek a bit of father-son bonding, that's all!", "William"], ["Besides...you OWE me after how you failed me in the bunker.", "William"], ["Tch...I should've known.", "Michael"], ["Oh, come now. I'm trying to extend the olive branch here!", "William"], ["As a means to further your own selfish desires, no doubt.", "Michael"], ["Easy, Michael! Listen, if you come with me I'll... erm, what do kids like...", "William"], ["I'll buy you a scoop of ice cream...?", "William"], ["...", "Michael"], ["Right. Ixnay on the oopscay. My apologies.", "William"], ["An apology... There's a first.", "Michael"]];
                
                case UnknownEnum.Value_5:
                    return [["...Go away...", "Vannabelle"], ["Vanny, my dear! All I seek is to thank you for aiding in the construction of my ultimate form. Is that so wrong?", "William"], ["You...You killed me! You stabbed me through the heart!!", "Vannabelle"], ["Well, I'm sorry you feel that way.", "William"], ["You see, Vanny, I was SIMPLY trying to give you a firm pat on the back.", "William"], ["Perhaps I was just a little too firm! Even I make mistakes sometimes.", "William"], ["...A mistake.", "Vannabelle"], ["Yes! Glad we got that cleared up. Very glad. Now, what I ACTUALLY wanted to talk about!", "William"], ["Were my specifications not PRECISE enough!? If you knew anything about my history, you would've remembered to make my new body FIREPROOF!", "William"], ["Really, a fabric coat? Made of TABLECLOTHS!? It's like you WANTED me to burn to death!", "William"], ["And that GARISH star...how is that meant to strike fear into my victims!? And one from Henry's blasted BEAR for god's sake!?", "William"], ["And the TV head!? ONLY 30 CHANNELS!? Oh, you might as well have put my soul into Mr. Hugs!", "William"], ["...If I agree to come along, will that shut you up?", "Vannabelle"]];
                
                case UnknownEnum.Value_6:
                    return [["...Let me guess, you feel my talents are wasted and that I'd really get to spread my wings at Afton Robotics?", "Clark"], ["What? No!", "William"], ["...Well, yes. But that's besides the point!", "William"], ["Henry's designs are holding you back! They're archaic, simple-minded!", "William"], ["MY designs, on the other hand, are FAR more advanced. Something I'm sure you'd find to be a sufficient challenge!", "William"], ["I've SEEN under the hood of your stuff already. It's nothin' to write home about.", "Clark"], ["Why, you little...!", "William"], ["I don't care about whatever argument you've come up with this time. Just guide me to the exit or whatever.", "Clark"]];
                
                case UnknownEnum.Value_8:
                    return [["Well, aren't you the sharp dresser! What's more, word on the obituary is that you're the man currently running my company.", "William"], ["Who the heck are you? I ain't ever seen your ugly mug before! Get lost!", "The Boss"], ["Oh, please, as a fellow businessman, I won't waste your time.", "William"], ["I was Fazbear Entertainment's original roboticist, you have me to thank for your little animatronic moneymakers.", "William"], ["And if you want to increase your profits...I may know of a certain animatronic that is sure to make headlines.", "William"], ["Ho ho, you for real?", "The Boss"], ["As true as Bonnie is blue!", "William"], ["Just help me get out of here, and I'll show you where to find the show-stopper in question.", "William"], ["Or you could stop wasting my time and just tell me, you scheming shrew...", "The Boss"], ["Oh, no, no. I assure you it's a two-man job.", "William"]];
                
                case UnknownEnum.Value_10:
                    return [["...Here to twist the knife, are you?", "Henry"], ["Oh, don't be like that. What's a little drinking between old business partners? Dulls the pain, you know.", "William"], ["As if. What pain have you endured, exactly?", "Henry"], ["Oh, how typical of YOU to say that, Henry. You understand nothing of my suffering.", "William"], ["I thought you'd see things my way once you understood what losing your favorite child felt like.", "William"], ["...", "Henry"], ["Let me make one thing very clear, William.", "Henry"], ["I am going to help you. Not because you've convinced me, or because you are an old friend.", "Henry"], ["I am going to do it because the sooner we find an exit, the sooner you can burn in hell for all eternity.", "Henry"], ["Well then! Let's not keep the devil waiting, old friend!", "William"]];
                
                case UnknownEnum.Value_12:
                    return [["Ah, Will! Thank goodness, finally someone I can trust here in Fredbear's Inferno!", "Edwin"], ["Bah, spare me your sarcasm.", "William"], ["...Huh? Why would I be sarcastic?", "Edwin"], ["...Nevermind, then. Happy to chat with an old friend!", "William"], ["You know, that horrible rust-bucket of yours has given me quite a bit of grief in my time here. It's relentless, I tell you!", "William"], ["Oh, M2? Boy, you're telling me! I don't know where this Angel gets off making it all bloodthirsty like that...", "Edwin"], ["Bah, the audacity! Taking something so lovely and turning it into some...some sort of KILLING MACHINE! Who would DO that!?", "Edwin"], ["*COUGH* Indeed! *COUGH* It's...terrible I tell you!", "William"], ["...Say, you would probably know a thing or two about how to deal with that, wouldn't you?", "Edwin"], ["BAH! DEAL? DEAL WITH WHAT? ARE YOU A COP?", "William"], ["...The animatronics. You...programmed most of these guys yourself, right?", "Edwin"], ["Ah, yes, of course, I certainly do. I SUPPOSE I'm the best you're going to get in this place.", "William"], ["Oh, well, most definitely!", "Edwin"], ["Knowing your technical skill, you've gotta know everything there IS to know about all those guys!", "Edwin"], ["And knowing your intelligence as an inventor, I'm...", "Edwin"], ["...Not wrong to assume you added some means of deactivating them into their hardware, am I?", "Edwin"], ["Some means of what?", "William"]];
                
                case UnknownEnum.Value_13:
                    return [["You know, Fiona...it always did pain me to see such a brilliant talent go to waste.", "William"], ["Oh! Er...thank you? (Is that a...compliment?)", "Fiona"], ["As a matter of fact...I've always felt you and I have quite a bit in common!", "William"], ["We both wear purple, we both love our cartoon animals...", "William"], ["And we never receive the recognition we deserve for our work. Only the NINCOMPOOPS we work for!", "William"], ["...Er, work with.", "William"], ["What are you, er...getting at, exactly?", "Fiona"], ["Why, it's simple: Your abilities would be of GREAT use to me!", "William"], ["And with our minds put together, I'm sure we'll escape this place yet...and leave ALL who doubted us in the dust!", "William"], ["What say you, Mrs. Murray?", "William"], ["Well... It's worth a shot, I suppose!", "Fiona"]];
                
                case UnknownEnum.Value_16:
                    return [["OH NO, NO NO NO NO. GET AWAY FROM ME!!", "Hudson"], ["Settle down, boy! I simply wish to bury the hatchet, is all!", "William"], ["After having some time to think about it...I realized something.", "William"], ["Hudson, in a way... You're like the elder son I wish I had.", "William"], ["...What?", "Hudson"], ["Yes! Someone as jumpy as yourself would've had hilarious reactions to my little pet projects!", "William"], ["You would've been MUCH nicer to have around the house instead of that ODIOUS Michael.", "William"], ["...What?", "Hudson"], ["Ah, it's no matter. Better late than never, I say!", "William"], ["Why not come along and make up for lost time, my boy?", "William"], ["...", "Hudson"], ["...What?", "Hudson"]];
                
                case UnknownEnum.Value_9:
                    return [["You're the only one here who's not produced a peep of intolerable noise... And I must say, you have a rather dashing name as well!", "William"], ["Should you keep that up, I could use a man like you by my side.", "William"], ["How's that sound, other William?", "William"], ["William may have garnered a bit of a negative reputation around here, but Billy was happy to have a powerful ally!", ""]];
                
                case UnknownEnum.Value_15:
                    return [["Hello, little child! What's your name?", "William"], ["...Do I know you?", "Cassie"], ["...Pah. Children of this generation have no manners.", "William"], ["It isn't safe for you here, you know. You never know when a big...er...", "William"], ["...BLUE rabbit will jump out and try to get you!", "William"], ["That's...a normal occurrence around here?", "Cassie"], ["Oh, of course! I've seen it happen at least seven times, as a matter of fact!", "William"], ["So it's...not just me, then.", "Cassie"], ["...How much do you know about big, scary, cartoon rabbits? Do you think you can help me keep them away?", "Cassie"], ["Oh, believe me, young one...", "William"], ["If there's ANYTHING I know a thing or two about, it's big, scary, cartoon rabbits.", "William"]];
                
                case UnknownEnum.Value_17:
                    return [["...Thanks for the beer, complete stranger.", "Mary"], ["Of course! It's the LEAST I could do for a poor child like yourself.", "William"], ["How cruel this Angel must be to trap poor, innocent children in this hellish place...", "William"], ["It's a good thing you have a talented leader such as myself to guide you!", "William"], ["...Yeah? Well uh...thanks, but I think I'll be fine.", "Mary"], ["Oh, please! I'd have to be some manner of monster to allow you to roam this plane alone!", "William"], ["Right...", "Mary"], ["Monster, yeah.", "Mary"], ["You mean you'll REALLY take care of me?", "Mary"], ["Of course I will!", "William"], ["And you'll save me from those scary robots?", "Mary"], ["Oh, there's no need to be afraid when I'm around!", "William"], ["And you'll promise to stuff my corpse in the vents if I talk back?", "Mary"], ["It would be my pl- HEY!", "William"], ["Alright, what tipped you off?", "William"], ["Buying a kid beer is a pretty big red flag, man.", "Mary"], ["...And I haven't even mentioned the suspenders.", "Mary"], ["Suspenders are the thinking man's overalls! They're...they're DISTINGUISHED!", "William"], ["Fine, then! If you're going to be like THAT, then have fun toiling away in this place on your own!", "William"], ["Oh no don't get the wrong idea, I'm coming with. Anything's better than this..", "Mary"], ["Ah, excellent! (The old Afton charm still works!)", "William"]];
                
                case UnknownEnum.Value_14:
                    return [["What are you doing here, Elizabeth?", "William"], ["OH! F-Father!", "Elizabeth"], ["I-I apologize for wandering off on my own. It's just, that I...I...", "Elizabeth"], ["Ah, don't you worry your little head, Elizabeth! I'll let this go, just this once.", "William"], ["You...you really mean it? Oh, THANK YOU, father!", "Elizabeth"], ["Yes, yes...now COME ALONG! I'm not letting you wander off again, now!", "William"], ["B-But...I didn't finish the drink you got for me!", "Elizabeth"], ["Did I stutter?", "William"]];
                
                default:
                    return bar_dialogue_array(-1, arg1);
            }
        
        case UnknownEnum.Value_12:
            switch (arg1)
