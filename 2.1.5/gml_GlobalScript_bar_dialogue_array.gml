                case UnknownEnum.Value_0:
                    return [["Hey, thanks a lot! Remind me to buy you one later!", "Jeremy"], ["Have you been holding up well?", "Jeremy"], ["Could be a lot better...Ugh, this whole thing is such bad luck...", "Hudson"], ["Huh, do you really think so? I see it as a whole lot of good luck!", "Jeremy"], ["How much luckier can you get than getting a second chance at life?", "Jeremy"], ["...Maybe, but...I dunno, it feels like even if I get out of here, I'm not sure what I have to look forward to in my life.", "Hudson"], ["Aw, there's gotta be something! You've got friends, don't you!", "Jeremy"], ["Y-yeah! You're right! Barry...Duane...When I get back, they'll be there for me!", "Hudson"], ["...Oh, but...they're going off to the navy. And...", "Hudson"], ["...And I can't go with them.", "Hudson"], ["Oh! Well gosh, I'm sorry to hear that...", "Jeremy"], ["Well, what about your parents?", "Jeremy"], ["Both of them are dead.", "Hudson"], ["...O-Oh. Oh dear.", "Jeremy"], ["...Pets?", "Jeremy"], ["...", "Hudson"], ["...Wait a second. Yeah! Mr. Whiskers! He needs me!", "Hudson"], ["Yeah!!! Now you're getting it! C'mon, let's go reunite you two!", "Jeremy"]];
                
