                    return bar_dialogue_array(arg1, arg0, true);
                
                case UnknownEnum.Value_2:
                    return [["Here you go! A cup of joe for an average working joe!", "Edwin"], ["Oh! Well thank y-", "Vanessa"], ["JANE! W-Working Jane? Is that right?", "Edwin"], ["...", "Vanessa"], [" ", "Edwin"], ["You should stop talking.", "Vanessa"], ["Okay.", "Edwin"]];
                
                case UnknownEnum.Value_8:
                    return [["Good day, sir! You look like an esteemed business man! Are you looking for a solid investment?", "Edwin"], ["Eh? Investment? What on earth could you have for me to invest in, little man?", "The Boss"], ["Why, you haven't heard of Edwin Murray's Costume Manor? We're leading the game in entertainment!", "Edwin"], ["Innovative carnival games, costumed entertainment...", "Edwin"], ["A potential investor like you could stand to make a lot of money!", "Edwin"], ["Why, just look around you! Fazbear Entertainment was an investor in the early stages of their company.", "Edwin"], ["And just behold the company now!", "Edwin"], ["They have come very far indeed, with MCM technology!", "Edwin"], ["...Wait, Fazbear's? You worked with the old chumps who owned the joint?", "The Boss"], ["Y-Yes! T-Technically it's, more like they own me, they've become my main project funder...", "Edwin"], ["But that's just-", "Edwin"], ["THEY'VE BEEN HIDING EVEN MOOOORE PROPERTY UNDER MY NOSE?!?!", "The Boss"], ["GET MOVING, YOU'RE SHOWING ME EX-ACT-LY WHERE THIS \"MORON COSTLY MANOR\" IS!!!", "The Boss"], ["Y-Yes sir!!!", "Edwin"]];
                
                case UnknownEnum.Value_10:
                    return [["...Ah, Edwin! It's...been quite some time, hasn't it?", "Henry"], ["I...do hope there isn't still bad blood between us. I apologize for how our company treated you.", "Henry"], ["Ah, not at all! After all I've faced here, it's hard holding onto silly grudges like that.", "Edwin"], ["...", "Edwin"], ["...But you DO acknowledge that Fiona's designs WERE better, right?", "Edwin"], ["...They did have their charm, yes.", "Henry"], ["...Hmph.", "Edwin"], ["Regardless, gosh, I can only imagine all you've got up to after all these years!", "Edwin"], ["Your company, your inventions...oh man, and Charlie! How's SHE doing?", "Edwin"], ["O-Oh! Charlie? Well, you know, she's er...", "Henry"], ["...She's fine. How about David?", "Henry"], ["...", "Edwin"], ["...Good!", "Edwin"], ["Good.", "Henry"], ["...", "Henry"], ["...Well, no use standing around here is there?", "Henry"], ["Nope, not at all!", "Edwin"]];
                
                case UnknownEnum.Value_11:
                    return [["...Ah, you. What is it you want from me this time?", "William"], ["Just a minute of your time, Will! I thought this little gesture was the least I could do in return for all you've done for me!", "Edwin"], ["In a...revenge sort of way?", "William"], ["Oh, you kidder! It's a showing of thanks!", "Edwin"], ["Do you remember back when we were still in college? When my Magic Coat Rack flopped and you were failing to court any investors?", "Edwin"], ["Pah, don't remind me.", "William"], ["Well, I remember whenever you were at your lowest, you always had that saying!", "Edwin"], ["No matter how many times you failed, no matter how many loans you defaulted on...", "Edwin"], ["...You always just shouted \"I always come back\", and you were right back on your feet before you knew it!", "Edwin"], ["I...what?", "William"], ["Yeah! It was like some kind of magic spell, the way you got right back in there and turned things around!", "Edwin"], ["...So I began saying it myself! And wouldn't you know it, it helped me out a whole lot too!", "Edwin"], ["Whenever another employee left, whenever another product flopped, I just told myself, I'll always come back...", "Edwin"], ["...And I did! ...For a while, at least.", "Edwin"], ["Pah! Nobody likes a plagiarist, Mr. Murray.", "William"], ["Oh, speak for yourself! I KNOW Spring Bonnie got that purple bowtie from me.", "Edwin"], ["...Well, even I have to admit it was rather fashionable.", "William"]];
                
                case UnknownEnum.Value_13:
                    return [["Fiona, Fiona! Oh, thank GOODNESS I caught you!", "Edwin"], ["I've concocted my best idea yet! A way we'll never have to be separated again!", "Edwin"], ["Oh! Really? What'd you come up with?", "Fiona"], ["Well, when we get judged by the Angel, our deaths were so far apart I fear that we...won't be put together again.", "Edwin"], ["Even now, if one of us gets there before the other, we'll be split apart...", "Edwin"], ["But...I realized something!", "Edwin"], ["We could just...stay here!", "Edwin"], ["...Here? In this inferno?", "Fiona"], ["Oh no no, not HERE in the bar. Or the tower, for that matter!", "Edwin"], ["You see, the outside is quite rife with materials! Wood to make a house, fish to eat...", "Edwin"], ["Oh, Edwin... That sounds lovely, but I...", "Fiona"], ["Oh, don't worry, I thought of that too!", "Edwin"], ["Once we run out of fish, I can sneak back into the tower and grab one of those bottomless candy bowls!", "Edwin"], ["Knowing what I do about this realm, I have good reason to believe we don't age here!", "Edwin"], ["We'd be able to settle down and live together forever here! Maybe make some friends to settle down with us...", "Edwin"], ["Why, we could get a WHOLE community going! Right here, for as long as we want!", "Edwin"], ["...", "Fiona"], ["...Is...something the matter?", "Edwin"], ["Ed...I understand where you're coming from, don't get me wrong...", "Fiona"], ["But, I don't think that's a very good idea.", "Fiona"], ["Are you kidding? W-We'd be able to get scrap from the tower, so we could get creating again!", "Edwin"], ["We'd be able to make anything! W-without the fear of meeting deadlines or budget!", "Edwin"], ["Ed, dear, it's just...", "Fiona"], ["We'd be able to be together forever... But I'm not so sure that's such a good thing.", "Fiona"], ["I don't know, is that really any way to live? We're not made to plant our feet and stay in one place forever...", "Fiona"], ["We've got to spread our wings! See all the world has to offer while we can!", "Fiona"], ["And...We've all got to be able to say goodbye when time is up.", "Fiona"], ["As long as we're here together, rather than prolong it by force...", "Fiona"], ["Why don't we make the most of the time we've got?", "Fiona"], ["...Alright...", "Edwin"], ["...Alright. If it's what'll make you happy, I'll...", "Edwin"], ["...I'll do it.", "Edwin"]];
                
                case UnknownEnum.Value_17:
                    return [["Gee, I suppose most patrons of this bar ARE much younger than myself in terms of the greater space-time continuum, but...", "Edwin"], ["...Should someone of your age really be drinking?", "Edwin"], ["Oh, no no, the drinking age has gone WAY down since you died, trust me.", "Mary"], ["Wow! Really?", "Edwin"], ["NO.", "Tipsy Bird"]];
                
                case UnknownEnum.Value_18:
                    return [["By jove, what a fascinating design ethos!", "Edwin"], ["Arms-a-plenty...And that face! You've had to have been some kind of bug, right?", "Edwin"], ["I can imagine you stationed within some kind of trunk or standee to cover your base...", "Edwin"], ["...Your logic is comprehensible, but COMPLETELY wrong!", "Strings"], ["My design was of a different origin. A different purpose!", "Strings"], ["Different...No, DEVOID of it! I LACKED purpose then! I had no sentience. NO GOAL.", "Strings"], ["My point is, I was never designed for a suit. I stand before you EXACTLY as I was intended to be seen!", "Strings"], ["...Though I never was. DESIGNED to be seen.", "Strings"], ["...At all.", "Strings"], ["Ah, function over form? Not unlike my own M2...I respect it!", "Edwin"], ["Your creator sounds like quite the inventor! Mind telling me more?", "Edwin"]];
                
                default:
                    return bar_dialogue_array(-1, arg1);
