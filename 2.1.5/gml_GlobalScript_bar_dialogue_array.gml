                case UnknownEnum.Value_15:
                    return [["Hey, Cassie! Your favorite juice flavor was...berry, right?", "Vanessa"], ["...Not quite, but I still really appreciate it!", "Cassie"], ["Shoot, I'm sorry.", "Vanessa"], ["No, no! It's fine, I still like this one! Th-Thank you!!", "Cassie"], ["If you say so...!", "Vanessa"], ["Unrelated, but I wanted to ask...", "Vanessa"], ["...Why DO you want to save Gregory so badly? Why HIM, of ALL people?", "Vanessa"], ["Well...He's my friend!", "Cassie"], ["Gregory might...seem...like a fine kid from a...distant glance.", "Vanessa"], ["But that kid is a freakin' NIGHTMARE.", "Vanessa"], ["C'mon, he's rambunctious, but he's really not that bad!", "Cassie"], ["He got banned from Roxy Raceway after driving off the track and running over 12 staff bots...", "Vanessa"], ["He got banned from Gator Golf for knocking Monty off the catwalks with a carefully-aimed golf shot...", "Vanessa"], ["...Nearly crushing a family of 3 due to his size...", "Vanessa"], ["And don't even get me started on what happened to Glamrock Chica.", "Vanessa"], ["I have no clue how a child that small can rip off a beak that clean.", "Vanessa"], ["He is- He's exhausting. Utterly exhausting.", "Vanessa"], ["Hey now, Gregory's a bit of a wild child...", "Cassie"], ["...And he may always be trying to get me to help with his wild schemes...", "Cassie"], ["...And he may like to prank me by putting DJ Music Man into bouncer mode every time I go to the arcade...", "Cassie"], ["...And he MAY have a tendency to laugh like a cartoon supervillain every time he does it...", "Cassie"], ["But he's my friend! I like hanging out with him and don't want him to be stuck here.", "Cassie"], ["Rrggghhh...", "Vanessa"], ["Alright. Alright alright, I'll...Help you look for him.", "Vanessa"], ["I think he's got a vendetta against me, so maybe you'll find him faster if we stick together.", "Vanessa"], ["Thank you, Vanessa! It really, really means a lot to me!!", "Cassie"]];
                
