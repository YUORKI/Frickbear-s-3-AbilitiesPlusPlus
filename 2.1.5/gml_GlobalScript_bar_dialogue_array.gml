                case UnknownEnum.Value_17:
                    return [["Awwww, what're you doin' here all by yourself, hun?", "Vannabelle"], ["I dunno. Waiting for a bar fight or for someone to start crying about their dead wife.", "Mary"], ["Geez! A...bit of a downer, aren't ya?", "Vannabelle"], ["Recreationally, sure.", "Mary"], ["Funny. Really, though...it can't be THAT boring around here, can it?", "Vannabelle"], ["You're asking a teenager if she's having a good time sitting around with a children's playmat watching OTHER people get drunk.", "Mary"], ["Well...couldn't you have brought SOMETHING to do? I bring a game console with me practically everywhere I go!", "Vannabelle"], ["My Aunt Jane took my games after she caught me playing after midnight.", "Mary"], ["...Stupid thing ratted me out after I closed it.", "Mary"], ["Awwww, that's a shame...", "Vannabelle"], ["...Oh, hey! I've got a copy of Powermon: Cryptic Cave! You could borrow it, if you want!", "Vannabelle"], ["...Alright, Lady, if anyone asks, you're a court appointed guardian.", "Mary"]];
                
