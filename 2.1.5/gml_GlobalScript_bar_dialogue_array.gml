                case UnknownEnum.Value_2:
                    return [["Hey, Vanessa! I got you some juice!", "Cassie"], ["Ah, thank,s Cassie. Hope you're holding up well in this place.", "Vanessa"], ["I wish I could have Roxy helping me...I wonder how Gregory managed to get Freddy on his side...", "Cassie"], ["The Glamrocks are...weird, like that.", "Vanessa"], ["To be quite honest, I changed jobs partly just to get away from them...", "Vanessa"], ["Aw, why? The Glamrocks are so fun!!", "Cassie"], ["Eeeeeh...", "Vanessa"], ["They're not so fun when you're working with them. Glamrock Freddy's always been especially...uh, easy to sway.", "Vanessa"], ["I don't think he could even hurt a fly...Which I CANNOT say for the rest.", "Vanessa"], ["Even Roxy?", "Cassie"], ["She has... moods every now and then. Usually just on bad days.", "Vanessa"], ["Just be glad your favorite isn't Monty, heheh! ...Or Glamrock Bonnie, for that matter.", "Vanessa"], ["Glamrock Bonnie? Didn't he just retire to a rockstar farm in Canada?", "Cassie"], ["...Something like that.", "Vanessa"], ["Hey, actually, I wonder if we'd be able to find him here...Wanna go look?", "Vanessa"]];
                
                case UnknownEnum.Value_5:
                    return [["Hey! Aren't you that, um...strange bunny lady I saw snooping around the pizzaplex?", "Cassie"], ["Regrettably...", "Vannabelle"], ["I wanted to... Huh? Oh, is that a touchy subject? S-Sorry!", "Cassie"], ["No no it's fine...! What were you gonna say?", "Vannabelle"], ["I guess, just, you were sneaking around a lot, right? I was always wondering...", "Cassie"], ["...What WERE you looking for?", "Cassie"], ["...A certain, uh, animatronic.", "Vannabelle"], ["At the time I THOUGHT it was down under the pizzaplex...", "Vannabelle"], ["...But it just turned out to be some dumb freaky endo PRETENDING to be the animatronic.", "Vannabelle"], ["W-Wait, really?! Did it have swirly orange eyes?", "Cassie"], ["Yeah, that's the one...", "Vannabelle"], ["More than anything I'm annoyed I wasted my time with that because it was so exhausting to navigate.", "Vannabelle"], ["Alongside all the OTHER reasons I regret all of that.", "Vannabelle"], ["W-Wait, how did you get out of there unharmed?! Where was the exit?!?", "Cassie"], ["...I mean, y'know, next to the entrance?", "Vannabelle"], ["...UUUUGHHH!!!", "Cassie"]];
                
                case UnknownEnum.Value_11:
                    return [["...Hm. Strange.", "William"], ["Normally I'M the one buying gifts to lure children to their gruesome demise, not the other way around...", "William"], ["What?", "Cassie"], ["Ah, it's nothing. Let us carry on.", "William"]];
                
                case UnknownEnum.Value_18:
                    var Start = [["Hey, you've been...taking a lot of notes about the other animatronics, right?", "Cassie"], ["Yes! Are you not?", "Strings"]];
                    
                    if (arg2)
                        Start = [["Mask...optical device...CAMERAS? Am I right to assume you've been recording data on this place, miss?", "Strings"]];
                    
                    return array_concat(Start, [["Sh-Should I?!", "Cassie"], ["NO?!", "Strings"], ["N-No?", "Cassie"], ["...YES!!! I meant YES. This tower is a locked door. Information is THE key!", "Strings"], ["Their movements, and attack windows! How can you get through without studying them!? Down to the MILLISECOND?!", "Strings"], ["If I didn't keep track of them all, I'd..! Oh, I'D...!!", "Strings"], ["Geez, I really am falling behind...", "Cassie"], ["Could, um...you, maybe, share some of your notes...?", "Cassie"], ["...If you're as wisened on animatronic assailants as me...And we're working together...", "Strings"], ["...Then...There will be mutual benefit from each other's assistance!", "Strings"], ["...YES! Yes. Why didn't I think of that!", "Strings"], ["C-Cool!", "Cassie"], ["...Where do we, uh... Start?", "Cassie"], ["At: LESSON ONE!", "Strings"]]);
                
                case UnknownEnum.Value_14:
                    return [["...Oh, thank you, kind miss!", "Elizabeth"], ["Er, do I...know you from father's restaurant?", "Elizabeth"], ["Heh, I doubt it. I only went there every once in a while...", "Cassie"], ["...Oh, though my dad IS an engineer there!", "Cassie"], ["An engineer? Oh, how wonderful! Which character did he design in your image?", "Elizabeth"], ["Oh, he - What?", "Cassie"], ["My father designed one of his robots just for me! He never did let me get near it, though...", "Elizabeth"], ["...But if your father was a designer as well, surely he did the same for you!", "Elizabeth"], ["I - Well, no, my dad wasn't...", "Cassie"], ["My dad's an engineer, not a designer! He's, uh...not really high up enough in the company to have a say with things like that.", "Cassie"], ["...O-Oh, but, uh...for one of my birthdays, he reprogrammed one of the Wet Floor Bots to say \"Happy birthday, Cassie!\" Heh, that was awesome of him...", "Cassie"], ["A wet floor bot? ...Those ones meant to clean up vomit, yes?", "Elizabeth"], ["...Okay, look. Neither of us are getting out of here without each other's help, so can we PLEASE get going?", "Cassie"]];
                
                case UnknownEnum.Value_17:
                    return [["Thanks, Cass.", "Mary"], ["Any time! I hope it's alright, I-I wasn't actually sure what you LIKED so I just got what they had at the cafeteria.", "Cassie"], ["Eh, I couldn't ca-", "Mary"], ["...Cafeteria?", "Mary"], ["...Yeah! A-At East Lake.", "Cassie"], ["...", "Mary"], ["...O-Our Middle School.", "Cassie"], ["You go to East Lake? Since when?", "Mary"], ["...Mary.", "Cassie"], ["Mary, we have the same homeroom.", "Cassie"], ["You're joking.", "Mary"], ["Mr. Berg. Room 125. I...sat in the...blue...spot.", "Cassie"], ["...Are you SURE it's the same Room 125?", "Mary"], ["Mary! We've practically sat across from each other for the whole year!", "Cassie"], ["Well you never piped up!", "Mary"], ["...I didn't either, though, but that's just because I...like it better that way.", "Mary"], ["I-I still can't believe you never noticed me! I always thought you were...", "Cassie"], ["...Thought I was what?", "Mary"], ["J-Judging me? Kinda?", "Cassie"], ["Oh my god.", "Mary"], ["Please tell me more.", "Mary"], ["W-Well you were always right there a-and if I turned around you'd see me and I didn't want you to so I...", "Cassie"], ["...Just glanced whenever we were at lunch?", "Cassie"], ["...So you were STALKING me?", "Mary"], ["NO! Nonono I-I didn't mean to- I didn't want- Oh my gosh I'm so sorry-", "Cassie"], ["Cassie, Cassie! Relax, I'm kidding!", "Mary"], ["Look, I get it! I'm not the most...approachable girl. But come on, you really think I'd have it out for you?", "Mary"], ["...Kinda?", "Cassie"], ["...You HAVE to know by thinking like that, we would've been instant best friends.", "Mary"], ["R-REALLY?", "Cassie"], ["Yeah! So let's get the hell out of hell, and shove it to Mr. Berg!", "Mary"], ["Y-Yeah. YEAH! S-SCREW HIM!", "Cassie"], ["YEAH! AND HIS STUPID VEST!", "Mary"], ["I-I actually like his vest.", "Cassie"], ["...AND HIS STUPID TIE!", "Mary"], ["YEAH, SCREW HIS TIE!", "Cassie"]];
                
                case UnknownEnum.Value_19:
