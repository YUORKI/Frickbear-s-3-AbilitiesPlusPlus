function generate_shuffle_array(arg0 = true)
{
    var _animatronics = countup_array(90);
    var _minigames = countup_array(15);
    var _phonecalls = voiceline_database(UnknownEnum.Value_128).ShuffleCalls;
    array_delete(_phonecalls, 0, 1);
    var _locations = [MinigameMaze_1, MinigameMaze_2, MinigameMaze_3, MinigameMaze_4];
    
    if (global.ShuffleMode)
    {
        _animatronics = array_shuffle(_animatronics);
        _minigames = array_shuffle(_minigames);
        _phonecalls = array_shuffle(_phonecalls);
        _locations = array_shuffle(_locations);
        array_sort(_phonecalls, function(arg0, arg1)
        {
            return array_contains(global.ShuffleCallsHeard, get_call_id(arg0)) - array_contains(global.ShuffleCallsHeard, get_call_id(arg1));
        });
        
        for (var i = 0; i < 6; i++)
        {
            if (i == 1)
                continue;
            
            if (_phonecalls[i] == voc_PhoneCall_WithLyrics)
            {
                var temp = _phonecalls[1];
                _phonecalls[1] = voc_PhoneCall_WithLyrics;
                _phonecalls[i] = temp;
                break;
            }
        }
        
        if (!array_contains(global.ShuffleCallsHeard, get_call_id(voc_PhoneCallTutorial)))
            _phonecalls[0] = voc_PhoneCallTutorial;
    }
    
    return 
    {
        Animatronics: _animatronics,
        Minigames: _minigames,
        PhoneCalls: _phonecalls,
        Locations: array_concat(_locations, [MinigameMaze_5])
    };
}

