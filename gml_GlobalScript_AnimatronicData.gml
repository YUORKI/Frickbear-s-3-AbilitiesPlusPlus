function get_animatronic_object(arg0)
{
    return get_animatronic_data(arg0).Object;
}

function get_jumpscare(arg0)
{
    var data = get_animatronic_data(arg0);
    return variable_struct_exists(data, "JumpscareSprite") ? data.JumpscareSprite : sNOTHING;
}

function get_tile(arg0)
{
    var data = get_animatronic_data(arg0);
    return variable_struct_exists(data, "Tile") ? data.Tile : sNOTHING;
}

global.AILevels = array_create(UnknownEnum.Value_201, 0);

function get_total_ai_levels()
{
    var ReturnValue = 0;
    
    for (var i = 0; i < array_length(global.AILevels); i++)
        ReturnValue += global.AILevels[i];
    
    return ReturnValue;
}

