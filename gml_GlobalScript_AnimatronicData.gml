function reset_descriptions()
{
    global.Descriptions = array_create(UnknownEnum.Value_201, ["UNKNOWN", "", ""]);
    global.Descriptions[UnknownEnum.Value_0] = ["Freddy", "Approaches from either hallway. Watch him on the cameras or listen for his voice and close the door when he's near."];
    global.Descriptions[UnknownEnum.Value_1] = ["Bonnie", "Approaches from the left. Close the door when he's near."];
    global.Descriptions[UnknownEnum.Value_2] = ["Chica", "Approaches from the right. Close the door when she's near."];
    global.Descriptions[UnknownEnum.Value_3] = ["Foxy", "Lurks in Pirate's Cove. Check on him often to keep him at bay, or close the left door if he makes a break for your office."];
    global.Descriptions[UnknownEnum.Value_4] = ["Golden Freddy", "Quickly throw on the mask when he appears in your office."];
    global.Descriptions[UnknownEnum.Value_5] = ["Endoskeleton", "Don't use your flashlight when it's at your window. ANY flashlight usage will make it attack."];
    global.Descriptions[UnknownEnum.Value_6] = ["Toy Freddy", "Beat his high score on a minigame of your choice before the end of the night."];
    global.Descriptions[UnknownEnum.Value_7] = ["Toy Bonnie", "Crawls through the vents. Use the audio lure to keep him away, or put the mask on when you hear him approach your office. Moves faster than other vent animatronics, but is more susceptible to the audio lure."];
    global.Descriptions[UnknownEnum.Value_8] = ["Toy Chica", "She'll send her cupcake into the office to spy on you before attacking. Click on her cupcake quickly to remove it and avoid her attack."];
    global.Descriptions[UnknownEnum.Value_9] = ["Mangle", "She moves to a random camera each time the camera's down, and will attack if looked at for too long. Check the sticky note on the office window to know what camera he's on."];
    global.Descriptions[UnknownEnum.Value_14] = ["BB", "Crawls through the vents. Put on the mask when he's near. He's unlikely to be fooled by the audio lure and will temporarily disable your flashlight if he gets in the office."];
    global.Descriptions[UnknownEnum.Value_15] = ["JJ", "Crawls through the vents. Put on the mask when she's near. She's immune to the heater and will temporarily disable your doors if she gets in the office."];
    global.Descriptions[UnknownEnum.Value_10] = ["Withered Freddy", "He'll walk between the two doorways. Watch him through the office window and close the door he's closest to when he leaves your sight."];
    global.Descriptions[UnknownEnum.Value_11] = ["Withered Bonnie", "When he appears in your office, throw on the mask and keep it on until he leaves."];
    global.Descriptions[UnknownEnum.Value_12] = ["Withered Chica", "Crawls through the vents. Use the audio lure to keep her away, or put the mask on when you hear her approach your office. Moves slower than other vent animatronics, but is less susceptible to the audio lure."];
    global.Descriptions[UnknownEnum.Value_13] = ["Withered Foxy", "He'll appear in the window at the front of your office. Shine your flashlight on him to make him go away."];
    global.Descriptions[UnknownEnum.Value_16] = ["Marionette", "Reset the music box when you see the warning flash."];
    global.Descriptions[UnknownEnum.Value_17] = ["Shadow Freddy", "He'll suddenly show up once per night, temporarily plunging your office into complete darkness. Use your flashlight to see through the dark."];
    global.Descriptions[UnknownEnum.Value_18] = ["RWQFSFASXC", "Slowly materializes in your office, appearing more quickly as the building heats up. Shine your flashlight on it to make it go away."];
    global.Descriptions[UnknownEnum.Value_19] = ["The Phantoms", "They'll appear on the camera view at random. Close or switch the cam quickly or use your flashlight to avoid their attack. They can't kill you, but they will jumpscare you and increase the office temperature if looked at for too long."];
    global.Descriptions[UnknownEnum.Value_20] = ["Springtrap", "He'll slowly emerge from the backstage hallway and make his way to your office. Shine your flashlight on him in the cameras to push him back. If he reaches the doorway, he'll never leave."];
    global.Descriptions[UnknownEnum.Value_21] = ["Plushtrap", "He'll appear at the window and quickly hide when flipping down the monitor. When this happens, shine your flashlight down the hallway he's closest to."];
    global.Descriptions[UnknownEnum.Value_22] = ["Nightmare Fredbear", "If his teeth begin closing in on you, cool the office down quickly."];
    global.Descriptions[UnknownEnum.Value_23] = ["Nightmare BB", "He'll sometimes appear on the cameras. Click on him repeatedly to remove him before he attacks."];
    global.Descriptions[UnknownEnum.Value_24] = ["Nightmarionne", "Avoid looking in its direction when it descends into your office."];
    global.Descriptions[UnknownEnum.Value_25] = ["Lolbit", "Will increase the price of all shop items when active."];
    global.Descriptions[UnknownEnum.Value_26] = ["Circus Baby", "Find and click on all of her Bidybabs on the cameras before the end of the night."];
    global.Descriptions[UnknownEnum.Value_27] = ["Funtime Freddy", "He'll attack from the hallways and use Bon-Bon to try and fake you out. If you hear him or see him on the cameras and Bon-Bon is with him, close the door he's at. If Bon-Bon is missing, close the opposite door."];
    global.Descriptions[UnknownEnum.Value_28] = ["Funtime Foxy", "A cardboard cutout in the Dining Area will display a showtime. When showtime hits, make sure your right door is closed."];
    global.Descriptions[UnknownEnum.Value_29] = ["Ballora", "When you hear her music begin playing, search the cameras for her four Minireenas and click on them before time runs out."];
    global.Descriptions[UnknownEnum.Value_30] = ["Helpy", "Will spawn a barrage of pop-up ads to block your view. Click the X button on these pop-ups to close them."];
    global.Descriptions[UnknownEnum.Value_31] = ["Music Man", "Plays random fake audio cues throughout the night. Can't kill you, but will absolutely annoy you."];
    global.Descriptions[UnknownEnum.Value_32] = ["Mr. Hippo", "Crawls through the vents. Use the audio lure to keep him away, or put the mask on when you hear him approach your office. The sound of his approach is much more subtle than other vent animatronics, but if he gets in the office, he'll cause a lengthy audio disturbance."];
    global.Descriptions[UnknownEnum.Value_33] = ["Lefty", "Crawls through the vents, though unlike other vent animatronics will actively avoid the audio lure whenever possible. If he reaches your office, the mask will not fool him."];
    global.Descriptions[UnknownEnum.Value_34] = ["Molten Freddy", "Approaches rapidly from either hallway. Listen for the increasingly loud sound of metal clattering and close the correct door when they're near."];
    global.Descriptions[UnknownEnum.Value_35] = ["Scrap Baby", "She'll appear backstage, draining your power and making a lot of noise. Administer a controlled shock to make her stop."];
    global.Descriptions[UnknownEnum.Value_36] = ["Twisted Wolf", "He'll suddenly appear in your office when flipping down the monitor. Click on his flashing illusion disc to disable it, stopping his attack."];
    global.Descriptions[UnknownEnum.Value_37] = ["Malhare", "He'll begin appearing after the monitor has been flipped up a certain amount of times. If you run out of flips, your monitor will be disabled for the rest of the night."];
    global.Descriptions[UnknownEnum.Value_38] = ["Dreadbear", "He'll appear at the center window. When he does, drag a piece of candy from the correct candy bowl to him to make him go away."];
    global.Descriptions[UnknownEnum.Value_39] = ["LolzHax", "He'll force you to add a new animatronic to the night. Select one from the popup menu when it appears."];
    global.Descriptions[UnknownEnum.Value_41] = ["Animdude", "A minigame window will appear on your screen once per night. Press space to jump and dodge obstacles. Losing all lives will result in a jumpscare."];
    global.Descriptions[UnknownEnum.Value_40] = ["Coffee", "He'll activate once per night, forcing you to play a minigame. Use the mouse to move Coffee up and down and hit the ball back. Missing the ball will cause a power outage."];
    global.Descriptions[UnknownEnum.Value_42] = ["Chipper", "Buy his lumber from the shop before 6 AM."];
    global.Descriptions[UnknownEnum.Value_43] = ["Sparky", "When you hear him bark, search for him on the cameras. Once you find the camera where his barking is loudest, zap him with a controlled shock."];
    global.Descriptions[UnknownEnum.Value_44] = ["Candy", "A countdown will appear on the office TV. Make sure your mask is on when it hits zero."];
    global.Descriptions[UnknownEnum.Value_45] = ["Popgoes", "He'll start in the dining area before moving to one of four rooms adjacent to it. Administer a controlled shock on the camera he moves to before he can use the printer."];
    global.Descriptions[UnknownEnum.Value_46] = ["Rodney", "Just ignore him."];
    global.Descriptions[UnknownEnum.Value_47] = ["Jack-O-Bonnie", "He'll run down either hallway. Listen out for him and shine your light into the doorway when he's close. He can also be blocked with the doors, but doing so will cause a sudden spike in the building's temperature."];
    global.Descriptions[UnknownEnum.Value_48] = ["Jack-O-Chica", "She'll walk past the office window searching for you. Put your mask on when her jack-o-lantern looks at you, or else the building's temperature will begin to rise rapidly."];
    global.Descriptions[UnknownEnum.Value_49] = ["Nightmare Mangle", "He'll travel down his own path through the vent system. Place the audio lure at the start of this path to lure her back up, but be careful to not let her make contact with it, otherwise the audio lure will be temporarily disabled."];
    global.Descriptions[UnknownEnum.Value_50] = ["Security", "An RPG minigame will be at the bottom of your screen. Press the FIGHT button to deal damage to enemies you encounter, and the HEAL button to recover health. Losing all HP will result in a jumpscare."];
    global.Descriptions[UnknownEnum.Value_51] = ["Deedee", "She'll drop a fishing line into your office, stealing your tokens. When this happens, go to the shop menu and click on her until she stops."];
    global.Descriptions[UnknownEnum.Value_52] = ["Chica's Magic Rainbow", "She'll pop up on the screen and shoot a ring of bullets. Dodge these bullets with your mouse to avoid losing power."];
    global.Descriptions[UnknownEnum.Value_53] = ["Ennard", "Wires will infest the vents, slowly making their way into your office. Click on these wires' weak points in the vents to destroy them, or pull them down and release them quickly if they get into the office."];
    global.Descriptions[UnknownEnum.Value_54] = ["Yenndo", "He has a chance of appearing every time you turn around or lower the monitor. Turn back around quickly to make him disappear."];
    global.Descriptions[UnknownEnum.Value_55] = ["Bonnet", "She'll pop up to block your view. Grab her and throw her by flicking your mouse."];
    global.Descriptions[UnknownEnum.Value_56] = ["Electrobab", "He'll tamper with the wiring on a random camera, causing the lights to go out. When they do, find the camera where the wiring has been cut, and reconnect the wires by dragging the left end of each wire to its matching right end."];
    global.Descriptions[UnknownEnum.Value_57] = ["Trash Gang", "They'll fill your inventory with useless junk, limiting the amount of items you can hold at a time."];
    global.Descriptions[UnknownEnum.Value_58] = ["Mr. Hugs", "He'll activate and move across the office window. Click on him to stop him before he reaches the other side."];
    global.Descriptions[UnknownEnum.Value_59] = ["Happy Frog", "A tablet will be sitting in the back of the office. When it activates, click it and solve the math problem it gives you."];
    global.Descriptions[UnknownEnum.Value_60] = ["Pigpatch", "Crawls through the vents. He's not fooled by the audio lure OR the mask, so use the heater to prevent him from getting into your office."];
    global.Descriptions[UnknownEnum.Value_61] = ["Nedd Bear", "Crawls through the vents. He's immune to the mask, but the audio lure will fool him 100% of the time."];
    global.Descriptions[UnknownEnum.Value_62] = ["Orville", "You'll be presented with a card at the start of the night. Memorize this card and select it when Orville appears in your office at the end of the night."];
    global.Descriptions[UnknownEnum.Value_63] = ["Scraptrap", "A list of tasks will be given to you on the control panel in the back of the office. Click on these tasks to run them, and finish them all before the end of the night to avoid a jumpscare."];
    global.Descriptions[UnknownEnum.Value_64] = ["Grimm Foxy", "He'll approach the right window in the back of the office, causing the building to heat up when he's readying to attack. Roll up the blinds and shine the light on him to push him back."];
    global.Descriptions[UnknownEnum.Value_65] = ["Freddy Frostbear", "He'll summon an arctic wind to blow your mouse cursor around."];
    global.Descriptions[UnknownEnum.Value_66] = ["Glamrock Freddy", "He'll walk to either doorway and give you some words of encouragement. If he collides with the door or you close it on him while he's talking, Gregory will be unleashed."];
    global.Descriptions[UnknownEnum.Value_67] = ["Roxanne Wolf", "Stare her down when she appears at the window. Looking away for too long will make her attack."];
    global.Descriptions[UnknownEnum.Value_68] = ["Montgomery Gator", "He'll appear at your window, striking a series of poses. Wait for him to lower his glasses and blind him with your flashlight."];
    global.Descriptions[UnknownEnum.Value_69] = ["Glamrock Chica", "When she appears at the window, turn around and assemble a pizza with the toppings she requests. Once you're done, drag the pizza back over to her and she'll leave you be."];
    global.Descriptions[UnknownEnum.Value_70] = ["Sun & Moon", "Keep an eye on the poster on the office's central window. If it's a Moon poster, turn around and open the blinds on the left window. If it's a Sun poster, keep the blinds closed."];
    global.Descriptions[UnknownEnum.Value_71] = ["M.X.E.S.", "It'll travel between the cameras, being visible on the camera map as it moves. Zap it when it arrives at a camera, and don't let it reach your office."];
    global.Descriptions[UnknownEnum.Value_72] = ["Very Informative Pig", "He'll appear every hour of the night and check your token counter. Make sure you meet his hourly token quotas."];
    global.Descriptions[UnknownEnum.Value_73] = ["The Mimic", "It'll be hidden inside one of the many mascot costumes roaming around the building, making a static noise when viewed. Watch the cameras and deduce which costume the Mimic is hiding in, then select this costume using the Data Diver behind you."];
    global.Descriptions[UnknownEnum.Value_74] = ["Jackie", "When she descends into the office, click on the crank in the office and move your mouser cursor in a clockwise circular motion to wind her back up."];
    global.Descriptions[UnknownEnum.Value_75] = ["Big Top", "He'll try to pry one of the two doors open. Mash the door button to close it on him."];
    global.Descriptions[UnknownEnum.Value_76] = ["Captain Cobalt", "Shine your flashlight on his puppet pirate crew until they go away. Each crew member acts a little differently."];
    global.Descriptions[UnknownEnum.Value_77] = ["White Tiger", "It will appear at a random point during the night and cover up your UI. Survive until it eventually goes away."];
    global.Descriptions[UnknownEnum.Value_78] = ["Sleepy Moon", "His Moon Meter will fill up as you play minigames, jumping up when you make a mistake. If the Moon Meter for a given minigame becomes full, that minigame will be disabled for the rest of the night."];
    global.Descriptions[UnknownEnum.Value_79] = ["Doofas", "Collect popsicles with your mouse as they appear on the screen. Taking too long to collect a popsicle will drain some of your power."];
    global.Descriptions[UnknownEnum.Value_80] = ["Blank", "A stack of papers sits in the back of the office for you to draw on. Click on these papers and trace over the unfinished areas as closely as possible. Straying too far off the lines or not finishing all the drawings before 6 AM will result in a jumpscare."];
    global.Descriptions[UnknownEnum.Value_81] = ["Archie", "Play his guessing game using the Freddy or Not console in the back of the office. Use the hints from incorrect guesses to narrow down the correct animatronic."];
    global.Descriptions[UnknownEnum.Value_82] = ["Bon", "He stands in the left corner of your office. If you suspect that he's becoming too active, use the controlled shock button in the back of the office to reset him. If he fully activates, however, this button will no longer stop him."];
    global.Descriptions[UnknownEnum.Value_83] = ["Vlad & Clara", "Your office TV will occasionally switch on, causing a very loud audio disturbance and interrupting your camera feed. Click on the TV to switch it back off."];
    global.Descriptions[UnknownEnum.Value_84] = ["The Reagent", "It'll start in the Dining Room before activating and moving to one of the two hallways, indicated by a sound cue. Check which doorway it's headed towards and drag the Wet Floor Bot in your office over to the correct doorway to block it."];
    global.Descriptions[UnknownEnum.Value_85] = ["Ignited Freddy", "He'll appear at the back window, indicated by a laugh. When he does, turn around and shine your flashlight into his eyes as he moves around until he leaves."];
    global.Descriptions[UnknownEnum.Value_86] = ["Spring-Bonnie?", "Collect plastic balls by mousing over them in the cameras, then turn around and click Spring-Bonnie's head to throw them at him and keep him away."];
    global.Descriptions[UnknownEnum.Value_87] = ["DJ Music Man", "He'll appear once per night, forcing you to engage in a rhythm minigame. Press the door buttons in the order he shows onscreen and on the right beat to survive."];
    global.Descriptions[UnknownEnum.Value_88] = ["Ralph", "He'll start in Parts & Service before slowly making his way to your office, moving camera to camera. Check on him to freeze him in place for a short while. Any progress he makes is permanent."];
    global.Descriptions[UnknownEnum.Value_89] = ["Foxy.EXE", "Anomalies will begin appearing on your monitor systems, causing a countdown to your doom if too many accumulate at once. Seek out irregularities in your monitor systems and click on them to make him go away."];
    global.Descriptions[UnknownEnum.Value_90] = ["Endoplush", "It'll run around the screen, chasing after your mouse pointer. Avoid touching it, or else it will continuously drain your power."];
    global.Descriptions[UnknownEnum.Value_127] = ["Phony Boss", "???"];
    global.Descriptions[UnknownEnum.Value_118] = ["Funtime Chica", "You are about to die."];
    global.Descriptions[UnknownEnum.Value_119] = ["Felix", "Pay off your token debt before 6 AM."];
    global.Descriptions[UnknownEnum.Value_126] = ["Psycho Foe Fredbear", ""];
    global.Descriptions[UnknownEnum.Value_122] = ["Nightmare Freddy", "Freddles will continuously appear outside your office. Shine your flashlight on them to make them go away. If any more than three latch onto you, Nightmare Freddy will enter himself."];
    global.Descriptions[UnknownEnum.Value_123] = ["Nightmare Bonnie", "He'll run down either hallway. Listen out for him and shine your light into the doorway when he's close."];
    global.Descriptions[UnknownEnum.Value_124] = ["Nightmare Chica", "She'll walk past the office window searching for you. Put your mask on when she looks at you."];
    global.Descriptions[UnknownEnum.Value_125] = ["Nightmare Foxy", "Keep an eye on his timer. Put your mask on when it hits zero."];
    global.Descriptions[UnknownEnum.Value_121] = ["Nightmare", "The temperature will rise over time, as well as each time you die in the game. He'll attack once the temperature bar is full."];
    global.Descriptions[UnknownEnum.Value_120] = ["Salvage", ""];
    global.Descriptions[UnknownEnum.Value_159] = ["Jeremy Fitzgerald", ""];
    global.Descriptions[UnknownEnum.Value_160] = ["Mike Schmidt", ""];
    global.Descriptions[UnknownEnum.Value_161] = ["Vanessa Shelley", ""];
    global.Descriptions[UnknownEnum.Value_162] = ["Fritz Smith", ""];
    global.Descriptions[UnknownEnum.Value_171] = ["Edwin Murray", ""];
    global.Descriptions[UnknownEnum.Value_172] = ["Fiona Murray", ""];
    global.Descriptions[UnknownEnum.Value_165] = ["Clark Fixy", ""];
    global.Descriptions[UnknownEnum.Value_166] = ["Fredsweeper Frank", ""];
    global.Descriptions[UnknownEnum.Value_164] = ["Vannabelle Dewlap", ""];
    global.Descriptions[UnknownEnum.Value_177] = ["Strings", ""];
    global.Descriptions[UnknownEnum.Value_176] = ["Mary Schmidt", ""];
    global.Descriptions[UnknownEnum.Value_178] = ["Sally Poodle", ""];
    global.Descriptions[UnknownEnum.Value_175] = ["Hudson Foster", ""];
    global.Descriptions[UnknownEnum.Value_174] = ["Cassie", ""];
    global.Descriptions[UnknownEnum.Value_168] = ["Billy McDudesman", ""];
    global.Descriptions[UnknownEnum.Value_179] = ["Old Man Consequences", ""];
    global.Descriptions[UnknownEnum.Value_163] = ["Michael Afton", ""];
    global.Descriptions[UnknownEnum.Value_167] = ["The Boss", ""];
    global.Descriptions[UnknownEnum.Value_169] = ["Henry Emily", ""];
    global.Descriptions[UnknownEnum.Value_170] = ["William Afton", ""];
    global.Descriptions[UnknownEnum.Value_173] = ["Elizabeth Afton", ""];
    global.Descriptions[UnknownEnum.Value_155] = ["Psychic Friend Fredbear", ""];
    global.Descriptions[UnknownEnum.Value_130] = ["Upgrade Cadet", ""];
    global.Descriptions[UnknownEnum.Value_154] = ["Endo Chaser", ""];
    global.Descriptions[UnknownEnum.Value_129] = ["Mendo", ""];
    global.Descriptions[UnknownEnum.Value_128] = ["Phone Guys", ""];
    global.Descriptions[UnknownEnum.Value_158] = ["Vanny", ""];
    global.Descriptions[UnknownEnum.Value_156] = ["The Missing Children", ""];
    global.Descriptions[UnknownEnum.Value_157] = ["Charlie Emily", ""];
    global.Descriptions[UnknownEnum.Value_200] = ["The Fan", ""];
    global.Descriptions[UnknownEnum.Value_201] = ["The Angel", ""];
    global.Descriptions[UnknownEnum.Value_131] = ["Rockstar Freddy", "Buy upgrades!"];
    global.Descriptions[UnknownEnum.Value_132] = ["Rockstar Bonnie", "Buy minigame cartridges!"];
    global.Descriptions[UnknownEnum.Value_133] = ["Rockstar Chica", "Buy consumable items!"];
    global.Descriptions[UnknownEnum.Value_134] = ["Rockstar Foxy", "Try your luck, win a prize!"];
    global.Descriptions[UnknownEnum.Value_135] = ["Browboy", "Permanently remove animatronics!"];
    global.Descriptions[UnknownEnum.Value_137] = ["Morse the Mole", "Skip ahead or go back a round!"];
    global.Descriptions[UnknownEnum.Value_140] = ["Carnie", "Play minigames, win a prize!"];
    global.Descriptions[UnknownEnum.Value_138] = ["Eleanor", "Take on additional challenges for big rewards!"];
    global.Descriptions[UnknownEnum.Value_139] = ["The Bobbiedots", "Personalize your animatronic selections!"];
    global.Descriptions[UnknownEnum.Value_142] = ["Nurse Dollie", "Recover lives!"];
    global.Descriptions[UnknownEnum.Value_136] = ["FazEnt Representative", "Take on extra enemies for a cash bonus!"];
    global.Descriptions[UnknownEnum.Value_143] = ["Tipsy Bird", "Recruit some help!"];
    global.Descriptions[UnknownEnum.Value_141] = ["El Chip", "Trade out your upgrades!"];
}

reset_descriptions();

function get_animatronic_data(arg0)
{
    switch (arg0)
    {
        case UnknownEnum.Value_0:
            return 
            {
                Object: oFreddy,
                JumpscareSprite: sJumpscare_Freddy,
                Tile: sTile_Freddy,
                Lethality: "Manageable",
                ScheduleType: UnknownEnum.Value_0,
                DefenseProcedure: ["Cameras", "Doors"],
                SalvageValue: 1500
            };
        
        case UnknownEnum.Value_1:
            return 
            {
                Object: oBonnie,
                JumpscareSprite: sJumpscare_Bonnie,
                Tile: sTile_Bonnie,
                Lethality: "Manageable",
