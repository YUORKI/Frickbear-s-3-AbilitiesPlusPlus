function get_deathquip(arg0, arg1 = undefined)
{
    var data = voiceline_database(arg0);
    var setName = "DeathQuips";
    
    if (variable_struct_exists(data, "DeathQuips_1"))
        setName = setName + "_" + string(global.JumpscareType);
    
    var VoiceLines = variable_struct_exists(data, setName) ? variable_struct_get(data, setName) : [sfxNOTHING];
    randomize();
    
    if (is_undefined(arg1))
        arg1 = ((global.DeathRecord[arg0] + global.FunValue[0]) * global.FunValue[1]) % array_length(VoiceLines);
    
    return VoiceLines[arg1];
}

function get_selection_voiceline(arg0)
{
    var data = voiceline_database(arg0);
    return variable_struct_exists(data, "Selection") ? data.Selection : sfxNOTHING;
}

function get_misc_voicelines(arg0, arg1)
{
    var data = voiceline_database(arg0);
    arg1 = "Misc_" + arg1;
    return variable_struct_exists(data, arg1) ? variable_struct_get(data, arg1) : [sfxNOTHING];
}

function get_deathcoin_voiceline(arg0)
{
    var data = voiceline_database(arg0);
    return variable_struct_exists(data, "Deathcoin") ? data.Deathcoin : sfxNOTHING;
}

function play_deathcoin_voiceline(arg0)
{
    return reverb_sound(global.DeathcoinLines[arg0], 0, 0, false, 1);
}

function play_selection_voiceline(arg0)
{
    bitcrush_sound(global.SelectionLines[arg0], 0, 0, false, 1, 8);
}

function get_guard_line(arg0, arg1)
{
    if (arg0 >= 21)
    {
        var dir = working_directory + "addons/" + guard_name(arg0) + "/voicelines";
        var QuipList = skin_sound_array_from_directory(dir, "voc_" + string_lower(arg1));
        
        if (array_length(QuipList) == 0)
            return sfxNOTHING;
        
        var File = choose_from_array(QuipList);
        return create_stream_from_filename(File);
    }
    
    return choose_from_array(get_misc_voicelines(UnknownEnum.Value_159 + arg0, arg1));
}

